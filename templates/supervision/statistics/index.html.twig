{% extends 'layout/app.html.twig' %}

{% block page_title %}Statistiques Sage{% endblock %}
{% block page_subtitle %}Commandes et factures Sage · CA comptabilisé, carnet BC et statuts{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --of-primary: #1A1F3C;
            --of-secondary: #2B3160;
            --of-accent: #00C2A8;
            --of-accent-hover: #00A891;
            --of-accent-light: #E6FAF8;
            --of-base: #F4F5F9;
            --of-surface: #FFFFFF;
            --of-border: rgba(26, 31, 60, 0.12);
            --of-border-soft: rgba(26, 31, 60, 0.06);
            --of-text-soft: rgba(26, 31, 60, 0.58);
            --of-text-muted: rgba(26, 31, 60, 0.42);
            --of-error: #E53E3E;
            --of-success: #10B981;
            --of-warning: #F59E0B;
            --of-info: #3B82F6;
            --of-invoice: #6D5BD0;
            --of-invoice-light: #F0EDFF;

            --of-radius-sm: 10px;
            --of-radius-md: 14px;
            --of-radius-lg: 20px;
            --of-radius-xl: 24px;

            --of-shadow-xs: 0 1px 2px rgba(26, 31, 60, 0.04);
            --of-shadow-sm: 0 2px 8px rgba(26, 31, 60, 0.06);
            --of-shadow-md: 0 8px 24px rgba(26, 31, 60, 0.08);
            --of-shadow-lg: 0 16px 40px rgba(26, 31, 60, 0.10);

            --of-transition: 180ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ========== BASE ========== */
        .sage-page {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: var(--of-primary);
            font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';
            -webkit-font-smoothing: antialiased;
        }

        .sage-page * {
            box-sizing: border-box;
        }

        .sage-page .num,
        .sage-page .erp-kpi__value,
        .sage-page .sage-metric__value {
            font-variant-numeric: tabular-nums;
            font-feature-settings: 'tnum' 1;
        }

        .sage-section {
            display: grid;
            gap: 20px;
            margin-bottom: 24px;
        }

        /* ========== HERO ========== */
        .sage-hero {
            position: relative;
            overflow: hidden;
            border-radius: var(--of-radius-xl);
            padding: 32px;
            background: linear-gradient(135deg, var(--of-primary) 0%, var(--of-secondary) 100%);
            color: #fff;
            box-shadow: var(--of-shadow-lg);
        }

        .sage-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, var(--of-accent) 0%, transparent 60%);
            opacity: 0.18;
            pointer-events: none;
        }

        .sage-hero::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -10%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, var(--of-accent) 0%, transparent 70%);
            opacity: 0.08;
            pointer-events: none;
        }

        .sage-hero__grid {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr);
            gap: 32px;
            align-items: center;
        }

        .sage-hero__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(0, 194, 168, 0.18);
            border: 1px solid rgba(0, 194, 168, 0.32);
            color: var(--of-accent-light);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .sage-hero__eyebrow .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--of-accent);
            box-shadow: 0 0 0 0 rgba(0, 194, 168, 0.6);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(0, 194, 168, 0.6); }
            70% { box-shadow: 0 0 0 8px rgba(0, 194, 168, 0); }
            100% { box-shadow: 0 0 0 0 rgba(0, 194, 168, 0); }
        }

        .sage-hero h1 {
            margin: 16px 0 8px;
            font-size: clamp(24px, 3vw, 32px);
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.15;
            color: #fff;
        }

        .sage-hero p {
            margin: 0;
            max-width: 620px;
            color: rgba(255, 255, 255, 0.75);
            font-size: 15px;
            line-height: 1.55;
        }

        .sage-hero__meta {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .sage-hero__meta-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: var(--of-radius-md);
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px);
        }

        .sage-hero__meta-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: rgba(0, 194, 168, 0.16);
            color: var(--of-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }

        .sage-hero__meta-text span {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: rgba(255, 255, 255, 0.55);
            font-weight: 600;
        }

        .sage-hero__meta-text strong {
            display: block;
            margin-top: 2px;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
        }

        /* ========== ALERT ========== */
        .sage-alert {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 16px 20px;
            border-radius: var(--of-radius-md);
            background: #FEF2F2;
            border: 1px solid rgba(229, 62, 62, 0.2);
            border-left: 3px solid var(--of-error);
            color: #991B1B;
        }

        .sage-alert__icon {
            font-size: 18px;
            margin-top: 2px;
        }

        .sage-alert strong {
            display: block;
            margin-bottom: 4px;
            color: var(--of-error);
        }

        .sage-definition {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 18px;
            border: 1px solid rgba(59, 130, 246, 0.18);
            border-radius: var(--of-radius-md);
            background: rgba(59, 130, 246, 0.06);
            color: #1E3A8A;
            font-size: 13px;
            line-height: 1.5;
        }

        .sage-definition > i {
            margin-top: 3px;
            color: var(--of-info);
        }

        .sage-definition strong,
        .sage-definition span {
            display: block;
        }

        .sage-definition code,
        .sage-kpi__meta code {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
        }

        /* ========== FILTRES ========== */
        .sage-filters {
            border-radius: var(--of-radius-xl);
            padding: 20px;
            background: var(--of-surface);
            border: 1px solid var(--of-border-soft);
            box-shadow: var(--of-shadow-sm);
        }

        .sage-filters__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 16px;
        }

        .sage-filters__title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            font-weight: 700;
            color: var(--of-primary);
        }

        .sage-filters__title .icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: var(--of-accent-light);
            color: var(--of-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .sage-period-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            padding: 4px;
            background: var(--of-base);
            border-radius: 12px;
        }

        .sage-period-chip {
            padding: 8px 14px;
            border: 0;
            background: transparent;
            color: var(--of-text-soft);
            font-size: 13px;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--of-transition);
            font-family: inherit;
        }

        .sage-period-chip:hover {
            color: var(--of-primary);
        }

        .sage-period-chip.is-active {
            background: var(--of-surface);
            color: var(--of-primary);
            box-shadow: var(--of-shadow-xs);
        }

        .sage-filters form {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 12px;
            align-items: end;
        }

        .sage-scope-switch {
            grid-column: span 12;
            margin: 0 0 4px;
            padding: 0;
            border: 0;
        }

        .sage-scope-switch legend {
            margin-bottom: 7px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--of-text-soft);
        }

        .sage-scope-switch__options {
            display: inline-flex;
            gap: 6px;
            padding: 4px;
            border-radius: 12px;
            background: var(--of-base);
        }

        .sage-scope-option {
            cursor: pointer;
        }

        .sage-scope-option input {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            opacity: 0;
        }

        .sage-scope-option span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 36px;
            padding: 0 14px;
            border: 1px solid transparent;
            border-radius: 9px;
            color: var(--of-text-soft);
            font-size: 13px;
            font-weight: 650;
            transition: var(--of-transition);
        }

        .sage-scope-option input:focus-visible + span {
            outline: 3px solid rgba(59, 130, 246, 0.24);
            outline-offset: 2px;
        }

        .sage-scope-option--all input:checked + span {
            border-color: var(--of-primary);
            background: var(--of-primary);
            color: #fff;
        }

        .sage-scope-option--orders input:checked + span {
            border-color: rgba(0, 194, 168, 0.28);
            background: var(--of-accent-light);
            color: var(--of-accent-hover);
        }

        .sage-scope-option--invoices input:checked + span {
            border-color: rgba(109, 91, 208, 0.28);
            background: var(--of-invoice-light);
            color: var(--of-invoice);
        }

        .sage-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .sage-field--sm { grid-column: span 2; }
        .sage-field--md { grid-column: span 3; }
        .sage-field--lg { grid-column: span 4; }
        .sage-field--actions {
            grid-column: span 12;
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            padding-top: 4px;
        }

        .sage-field label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--of-text-soft);
        }

        .sage-field input,
        .sage-field select {
            width: 100%;
            height: 42px;
            padding: 0 14px;
            border: 1px solid var(--of-border);
            border-radius: var(--of-radius-sm);
            background: var(--of-surface);
            color: var(--of-primary);
            font-family: inherit;
            font-size: 14px;
            font-weight: 500;
            transition: var(--of-transition);
        }

        .sage-field input:focus,
        .sage-field select:focus {
            outline: 0;
            border-color: var(--of-accent);
            box-shadow: 0 0 0 3px rgba(0, 194, 168, 0.12);
        }

        .sage-field input::placeholder {
            color: var(--of-text-muted);
            font-weight: 400;
        }

        .sage-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            height: 42px;
            padding: 0 18px;
            border-radius: var(--of-radius-sm);
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--of-transition);
            text-decoration: none;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .sage-btn--primary {
            background: var(--of-accent);
            color: #fff;
            box-shadow: 0 4px 12px rgba(0, 194, 168, 0.25);
        }

        .sage-btn--primary:hover {
            background: var(--of-accent-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 194, 168, 0.32);
        }

        .sage-btn:disabled,
        .sage-filters.is-loading .sage-period-chip {
            cursor: wait;
            opacity: 0.65;
        }

        .sage-btn--ghost {
            background: var(--of-surface);
            color: var(--of-text-soft);
            border-color: var(--of-border);
        }

        .sage-btn--ghost:hover {
            background: var(--of-base);
            color: var(--of-primary);
        }

        /* ========== KPI CARDS ========== */
        .sage-kpis {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 14px;
        }

        .sage-kpi {
            position: relative;
            overflow: hidden;
            padding: 20px;
            background: var(--of-surface);
            border: 1px solid var(--of-border-soft);
            border-radius: var(--of-radius-lg);
            box-shadow: var(--of-shadow-xs);
            transition: var(--of-transition);
        }

        .sage-kpi:hover {
            transform: translateY(-2px);
            box-shadow: var(--of-shadow-md);
            border-color: var(--of-border);
        }

        .sage-kpi--order { border-top: 3px solid var(--of-accent); }
        .sage-kpi--invoice { border-top: 3px solid var(--of-invoice); }
        .sage-kpi--pending { border-top: 3px solid var(--of-warning); }
        .sage-kpi--credit { border-top: 3px solid var(--of-error); }
        .sage-kpi--mixed { border-top: 3px solid var(--of-info); }

        .sage-kpi__head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .sage-kpi__label {
            font-size: 12px;
            font-weight: 600;
            color: var(--of-text-soft);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .sage-kpi__icon {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
        }

        .sage-kpi__icon--accent { background: var(--of-accent-light); color: var(--of-accent); }
        .sage-kpi__icon--success { background: rgba(16, 185, 129, 0.12); color: var(--of-success); }
        .sage-kpi__icon--warning { background: rgba(245, 158, 11, 0.12); color: var(--of-warning); }
        .sage-kpi__icon--info { background: rgba(59, 130, 246, 0.12); color: var(--of-info); }
        .sage-kpi__icon--danger { background: rgba(229, 62, 62, 0.12); color: var(--of-error); }
        .sage-kpi__icon--invoice { background: var(--of-invoice-light); color: var(--of-invoice); }

        .sage-kpi__value {
            font-size: clamp(20px, 2.2vw, 26px);
            font-weight: 700;
            color: var(--of-primary);
            line-height: 1.1;
            letter-spacing: -0.02em;
        }

        .sage-kpi__currency {
            font-size: 14px;
            font-weight: 600;
            color: var(--of-text-soft);
            margin-left: 2px;
        }

        .sage-kpi__meta {
            margin-top: 8px;
            font-size: 13px;
            color: var(--of-text-soft);
            line-height: 1.4;
        }

        .sage-kpi__bar {
            margin-top: 14px;
            height: 4px;
            background: var(--of-base);
            border-radius: 2px;
            overflow: hidden;
        }

        .sage-kpi__bar-fill {
            height: 100%;
            background: var(--of-accent);
            border-radius: 2px;
            transition: width 0.6s ease;
        }

        /* ========== COMPARAISON ========== */
        .sage-card {
            background: var(--of-surface);
            border: 1px solid var(--of-border-soft);
            border-radius: var(--of-radius-xl);
            box-shadow: var(--of-shadow-xs);
            overflow: hidden;
        }

        .sage-card__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 20px 22px 16px;
            border-bottom: 1px solid var(--of-border-soft);
        }

        .sage-card__title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            font-weight: 700;
            color: var(--of-primary);
        }

        .sage-card__title .icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: var(--of-accent-light);
            color: var(--of-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .sage-card__subtitle {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--of-text-soft);
            font-weight: 500;
        }

        .sage-card__body {
            padding: 20px 22px;
        }

        .sage-card__body--flush {
            padding: 0;
            overflow-x: auto;
        }

        .sage-comparison {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
        }

        .sage-metric {
            padding: 16px;
            border-radius: var(--of-radius-md);
            background: var(--of-base);
            border: 1px solid transparent;
            transition: var(--of-transition);
        }

        .sage-metric:hover {
            background: var(--of-surface);
            border-color: var(--of-border);
        }

        .sage-metric__label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--of-text-soft);
        }

        .sage-metric__value {
            display: block;
            margin-top: 8px;
            font-size: 22px;
            font-weight: 700;
            color: var(--of-primary);
            letter-spacing: -0.01em;
        }

        .sage-metric__previous {
            display: block;
            margin-top: 4px;
            font-size: 12px;
            color: var(--of-text-muted);
        }

        .sage-trend {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 10px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .sage-trend--up {
            background: rgba(16, 185, 129, 0.1);
            color: var(--of-success);
        }

        .sage-trend--down {
            background: rgba(229, 62, 62, 0.1);
            color: var(--of-error);
        }

        .sage-trend--flat {
            background: var(--of-base);
            color: var(--of-text-soft);
        }

        /* ========== CHARTS GRID ========== */
        .sage-chart-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 16px;
        }

        .sage-chart-stack {
            display: grid;
            gap: 16px;
        }

        .sage-chart-canvas {
            position: relative;
            min-height: 320px;
        }

        .sage-chart-canvas--sm {
            min-height: 260px;
        }

        .sage-chart-canvas--status {
            min-height: 210px;
        }

        .sage-status-charts {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
        }

        .sage-status-chart > strong {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            font-size: 12px;
        }

        .sage-legend-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
        }

        .sage-legend-dot--order { background: var(--of-accent); }
        .sage-legend-dot--invoice { background: var(--of-invoice); }

        /* ========== TABLES ========== */
        .sage-table-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.6fr) minmax(340px, 1fr);
            gap: 16px;
        }

        .sage-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .sage-table thead th {
            padding: 12px 16px;
            text-align: left;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--of-text-soft);
            background: var(--of-base);
            border-bottom: 1px solid var(--of-border-soft);
            white-space: nowrap;
        }

        .sage-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--of-border-soft);
            color: var(--of-primary);
            vertical-align: middle;
        }

        .sage-table tbody tr {
            transition: background 120ms ease;
        }

        .sage-table tbody tr:hover {
            background: rgba(0, 194, 168, 0.04);
        }

        .sage-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .sage-table tbody tr.is-selected {
            background: var(--of-accent-light);
        }

        .sage-table tbody tr.is-selected td:first-child {
            box-shadow: inset 3px 0 0 var(--of-accent);
        }

        .sage-table__num {
            font-variant-numeric: tabular-nums;
            font-weight: 600;
        }

        .sage-table__amount {
            font-variant-numeric: tabular-nums;
            font-weight: 600;
            color: var(--of-primary);
        }

        .sage-table__sub {
            display: block;
            margin-top: 2px;
            font-size: 12px;
            color: var(--of-text-soft);
            font-weight: 500;
        }

        .sage-piece-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 6px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            font-weight: 600;
            color: var(--of-accent);
            background: var(--of-accent-light);
            text-decoration: none;
            transition: var(--of-transition);
        }

        .sage-piece-link:hover {
            background: var(--of-accent);
            color: #fff;
        }

        .sage-badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 9px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
            background: var(--of-base);
            color: var(--of-text-soft);
        }

        .sage-badge--warning {
            background: rgba(245, 158, 11, 0.14);
            color: #9A5A00;
        }

        .sage-badge--neutral {
            background: var(--of-base);
            color: var(--of-text-soft);
        }

        .sage-document-badge {
            display: inline-flex;
            align-items: center;
            max-width: 160px;
            padding: 4px 9px;
            border-radius: 7px;
            font-size: 10px;
            font-weight: 750;
            line-height: 1.2;
            text-transform: uppercase;
            letter-spacing: 0.035em;
        }

        .sage-document-badge--order {
            background: var(--of-accent-light);
            color: var(--of-accent-hover);
        }

        .sage-document-badge--pending_invoice {
            background: rgba(245, 158, 11, 0.14);
            color: #9A5A00;
        }

        .sage-document-badge--posted_invoice {
            background: var(--of-invoice-light);
            color: var(--of-invoice);
        }

        .sage-text-order { color: var(--of-accent-hover) !important; }
        .sage-text-invoice { color: var(--of-invoice) !important; }

        .sage-empty {
            padding: 48px 24px;
            text-align: center;
            color: var(--of-text-soft);
            font-size: 14px;
        }

        .sage-empty__icon {
            font-size: 32px;
            color: var(--of-text-muted);
            margin-bottom: 12px;
        }

        .sage-empty__title {
            display: block;
            margin-bottom: 5px;
            color: var(--of-primary);
        }

        /* ========== DETAIL ========== */
        .sage-detail-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-bottom: 16px;
        }

        .sage-detail-metric {
            padding: 12px 14px;
            background: var(--of-base);
            border-radius: var(--of-radius-sm);
        }

        .sage-detail-metric span {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--of-text-soft);
            font-weight: 600;
        }

        .sage-detail-metric strong {
            display: block;
            margin-top: 4px;
            font-size: 14px;
            color: var(--of-primary);
            font-weight: 600;
        }

        .sage-detail-metric small {
            display: block;
            margin-top: 3px;
            color: var(--of-text-soft);
            font-size: 11px;
        }

        .sage-detail-metric--wide {
            grid-column: span 2;
        }

        .sage-detail-metric--highlight {
            background: var(--of-accent-light);
            border: 1px solid rgba(0, 194, 168, 0.2);
        }

        .sage-detail-metric--highlight strong {
            color: var(--of-accent);
        }

        .sage-detail-lines-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 22px 0 8px;
            font-size: 13px;
        }

        .sage-detail-lines-title span {
            color: var(--of-text-soft);
        }

        .sage-table-scroll {
            overflow-x: auto;
            margin: 0 -22px -20px;
        }

        .sage-table__reference {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
        }

        .sage-detail-error {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 16px;
            border-radius: var(--of-radius-md);
            background: #FEF2F2;
            color: #991B1B;
        }

        .sage-detail-error strong,
        .sage-detail-error span {
            display: block;
        }

        .sage-detail-error span {
            margin-top: 3px;
            font-size: 13px;
        }

        .sage-document-loading {
            display: grid;
            place-items: center;
            min-height: 260px;
            color: var(--of-text-soft);
            text-align: center;
        }

        .sage-document-loading i {
            display: block;
            margin-bottom: 12px;
            color: var(--of-accent);
            font-size: 24px;
        }

        .sage-inline-note {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--of-text-soft);
            font-size: 13px;
        }

        @media (min-width: 1121px) {
            .sage-document-detail-card {
                position: sticky;
                top: 20px;
                align-self: start;
            }
        }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 1440px) {
            .sage-kpis {
                grid-template-columns: repeat(3, 1fr);
            }
            .sage-comparison {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 1120px) {
            .sage-hero__grid,
            .sage-chart-grid,
            .sage-table-grid {
                grid-template-columns: 1fr;
            }
            .sage-field--sm,
            .sage-field--md,
            .sage-field--lg {
                grid-column: span 6;
            }
        }

        @media (max-width: 720px) {
            .sage-hero { padding: 24px; }
            .sage-kpis,
            .sage-comparison {
                grid-template-columns: 1fr;
            }
            .sage-field--sm,
            .sage-field--md,
            .sage-field--lg,
            .sage-field--actions {
                grid-column: span 12;
            }
            .sage-scope-switch__options {
                display: grid;
                width: 100%;
                grid-template-columns: 1fr;
            }
            .sage-scope-option span {
                justify-content: center;
                width: 100%;
            }
            .sage-detail-grid {
                grid-template-columns: 1fr;
            }
            .sage-detail-metric--wide {
                grid-column: span 1;
            }
            .sage-card__header {
                padding: 16px 18px 12px;
            }
            .sage-card__body {
                padding: 16px 18px;
            }
            .sage-table-scroll {
                margin: 0 -18px -16px;
            }
        }
    </style>
{% endblock %}

{% block content %}
    {% set sage = sageStatistics %}
    {% set isCommercialScope = isCommercialScope ?? false %}

    <div class="sage-page">
        <section class="sage-section">
            {% if isCommercialScope %}
                <div class="sage-alert" style="background:#EFF6FF; border-color:rgba(59,130,246,.2); border-left-color:var(--of-info); color:#1E3A8A;">
                    <i class="fas fa-user-lock sage-alert__icon" style="color:var(--of-info);"></i>
                    <div>
                        <strong style="color:var(--of-info);">Vue commerciale restreinte</strong>
                        <div>
                            Les statistiques Sage sont limitees a votre perimetre{% if commercialScopeName %} : {{ commercialScopeName }}{% endif %}.
                        </div>
                    </div>
                </div>
            {% endif %}

            {# ========== HERO ========== #}
            <div class="sage-hero">
                <div class="sage-hero__grid">
                    <div>
                        <span class="sage-hero__eyebrow">
                            <span class="dot"></span>
                            ERP Sage · Live
                        </span>
                        <h1>Pilotage commercial Sage</h1>
                        <p>
                            Une lecture temps réel séparant le CA comptabilisé, les factures en attente et le carnet
                            de commandes, avec le détail de chaque pièce sans quitter la page.
                        </p>
                    </div>
                    <div class="sage-hero__meta">
                        <div class="sage-hero__meta-item">
                            <div class="sage-hero__meta-icon"><i class="fas fa-calendar-alt"></i></div>
                            <div class="sage-hero__meta-text">
                                <span>Période analysée</span>
                                <strong>{{ sage ? sage.filters.date_debut ~ ' → ' ~ sage.filters.date_fin : 'Indisponible' }}</strong>
                            </div>
                        </div>
                        <div class="sage-hero__meta-item">
                            <div class="sage-hero__meta-icon"><i class="fas fa-layer-group"></i></div>
                            <div class="sage-hero__meta-text">
                                <span>Granularité</span>
                                <strong>{{ sage ? (sage.filters.group_by == 'year' ? 'Par année' : 'Par mois') : 'N/A' }}</strong>
                            </div>
                        </div>
                        <div class="sage-hero__meta-item">
                            <div class="sage-hero__meta-icon"><i class="fas fa-filter"></i></div>
                            <div class="sage-hero__meta-text">
                                <span>Vue active</span>
                                <strong>{{ sage ? (sage.filters.document_scope == 'orders' ? 'Commandes BC' : (sage.filters.document_scope == 'invoices' ? 'Factures / avoirs' : 'Globale')) : 'N/A' }}</strong>
                            </div>
                        </div>
                        <div class="sage-hero__meta-item">
                            <div class="sage-hero__meta-icon"><i class="fas fa-database"></i></div>
                            <div class="sage-hero__meta-text">
                                <span>Source de données</span>
                                <strong>Documents de vente Sage · types 1, 6 et 7</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ========== ALERT ========== #}
            {% if sageError %}
                <div class="sage-alert">
                    <i class="fas fa-exclamation-triangle sage-alert__icon"></i>
                    <div>
                        <strong>Lecture Sage indisponible</strong>
                        <div>{{ sageError }}</div>
                    </div>
                </div>
            {% endif %}

            {% if sage %}
                <div class="sage-definition" role="note">
                    <i class="fas fa-circle-info"></i>
                    <div>
                        <strong>Périmètre précis des indicateurs</strong>
                        <span>
                            Le CA correspond uniquement aux factures comptabilisées Sage (<code>type 7</code>), net des avoirs négatifs.
                            Les BC (<code>type 1</code>) et les factures à comptabiliser (<code>type 6</code>) restent séparés&nbsp;:
                            ils ne sont pas additionnés au CA, faute de lien Sage assez fiable pour éviter les doubles comptes.
                        </span>
                    </div>
                </div>
            {% endif %}

            {# ========== FILTRES ========== #}
            <div class="sage-filters">
                <div class="sage-filters__header">
                    <div class="sage-filters__title">
                        <span class="icon"><i class="fas fa-sliders-h"></i></span>
                        Filtres d'analyse
                    </div>
                    <div class="sage-period-chips" role="tablist" aria-label="Période rapide">
                        {% set periods = {
                            'current_month': 'Mois en cours',
                            'current_year': 'Année en cours',
                            'last_3_months': '3 derniers mois',
                            'last_12_months': '12 derniers mois',
                            'custom': 'Personnalisée'
                        } %}
                        {% for value, label in periods %}
                            <button
                                type="button"
                                class="sage-period-chip {{ sage and sage.filters.period == value ? 'is-active' : '' }}"
                                data-period="{{ value }}"
                                role="tab"
                                aria-selected="{{ sage and sage.filters.period == value ? 'true' : 'false' }}"
                            >{{ label }}</button>
                        {% endfor %}
                    </div>
                </div>

                <form method="get" id="sageFiltersForm" data-turbo="true" data-turbo-action="replace">
                    <fieldset class="sage-scope-switch">
                        <legend>Documents affichés</legend>
                        {% set scopes = {
                            'all': ['Vue globale', 'fa-layer-group'],
                            'orders': ['Commandes BC', 'fa-file-signature'],
                            'invoices': ['Factures', 'fa-file-invoice-dollar']
                        } %}
                        <div class="sage-scope-switch__options">
                            {% for value, option in scopes %}
                                <label class="sage-scope-option sage-scope-option--{{ value }}">
                                    <input type="radio" name="document_scope" value="{{ value }}" {{ (sage and sage.filters.document_scope == value) or (not sage and value == 'all') ? 'checked' : '' }}>
                                    <span><i class="fas {{ option[1] }}"></i>{{ option[0] }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>
                    <div class="sage-field sage-field--sm">
                        <label for="period">Période</label>
                        <select id="period" name="period">
                            {% for value, label in periods %}
                                <option value="{{ value }}" {{ sage and sage.filters.period == value ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="sage-field sage-field--sm">
                        <label for="group_by">Vue</label>
                        <select id="group_by" name="group_by">
                            <option value="month" {{ sage and sage.filters.group_by == 'month' ? 'selected' : '' }}>Par mois</option>
                            <option value="year" {{ sage and sage.filters.group_by == 'year' ? 'selected' : '' }}>Par année</option>
                        </select>
                    </div>
                    <div class="sage-field sage-field--sm">
                        <label for="date_debut">Du</label>
                        <input id="date_debut" type="date" name="date_debut" value="{{ sage ? sage.filters.date_debut : '' }}">
                    </div>
                    <div class="sage-field sage-field--sm">
                        <label for="date_fin">Au</label>
                        <input id="date_fin" type="date" name="date_fin" value="{{ sage ? sage.filters.date_fin : '' }}">
                    </div>
                    <div class="sage-field sage-field--md">
                        <label for="representant">Commercial</label>
                        <select id="representant" name="representant" {{ isCommercialScope ? 'disabled' : '' }}>
                            {% if not isCommercialScope %}
                                <option value="">Tous les commerciaux</option>
                            {% endif %}
                            {% for representant in sage ? sage.representants : [] %}
                                <option value="{{ representant.value }}" {{ sage and sage.filters.representant == representant.value ? 'selected' : '' }}>{{ representant.label }}</option>
                            {% endfor %}
                        </select>
                        {% if isCommercialScope %}
                            <input type="hidden" name="representant" value="{{ sage ? sage.filters.representant : '' }}">
                        {% endif %}
                    </div>
                    <div class="sage-field sage-field--md">
                        <label for="piece">Numéro de pièce</label>
                        <input id="piece" type="text" name="piece" value="{{ sage ? sage.filters.piece : '' }}" placeholder="BC, FA, FV…">
                    </div>
                    {% if not sage or sage.filters.document_scope != 'orders' %}
                        <div class="sage-field sage-field--md">
                            <label for="invoice_state">État des factures</label>
                            <select id="invoice_state" name="invoice_state">
                                <option value="all" {{ sage and sage.filters.invoice_state == 'all' ? 'selected' : '' }}>Toutes</option>
                                <option value="pending" {{ sage and sage.filters.invoice_state == 'pending' ? 'selected' : '' }}>À comptabiliser</option>
                                <option value="posted" {{ sage and sage.filters.invoice_state == 'posted' ? 'selected' : '' }}>Comptabilisées</option>
                            </select>
                        </div>
                    {% endif %}
                    <input type="hidden" name="table_limit" value="15">

                    <div class="sage-field--actions">
                        <a class="sage-btn sage-btn--ghost" href="{{ path('supervision_statistics_index') }}">
                            <i class="fas fa-rotate-left"></i>
                            Réinitialiser
                        </a>
                        <button class="sage-btn sage-btn--primary" type="submit">
                            <i class="fas fa-chart-line"></i>
                            Analyser
                        </button>
                    </div>
                </form>
            </div>

            {% if sage %}

                {# ========== KPI CARDS ========== #}
                <div class="sage-kpis">
                    {% if sage.filters.document_scope == 'orders' %}
                        <article class="sage-kpi sage-kpi--order">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">Commandes BC</span><div class="sage-kpi__icon sage-kpi__icon--accent"><i class="fas fa-file-signature"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.order_count|number_format(0, ',', ' ') }}</div>
                            <div class="sage-kpi__meta">Bons de commande clients Sage</div>
                        </article>
                        <article class="sage-kpi sage-kpi--order">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">Carnet BC HT</span><div class="sage-kpi__icon sage-kpi__icon--accent"><i class="fas fa-euro-sign"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.ordered_amount_ht|number_format(2, ',', ' ') }}<span class="sage-kpi__currency">€</span></div>
                            <div class="sage-kpi__meta">Somme des BC retournés par Sage</div>
                        </article>
                        <article class="sage-kpi sage-kpi--order">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">Montant BC TTC</span><div class="sage-kpi__icon sage-kpi__icon--info"><i class="fas fa-receipt"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.ordered_amount_ttc|number_format(2, ',', ' ') }}<span class="sage-kpi__currency">€</span></div>
                            <div class="sage-kpi__meta">Montant TTC des commandes</div>
                        </article>
                        <article class="sage-kpi sage-kpi--order">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">Panier moyen BC HT</span><div class="sage-kpi__icon sage-kpi__icon--info"><i class="fas fa-calculator"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.average_order_ht|number_format(2, ',', ' ') }}<span class="sage-kpi__currency">€</span></div>
                            <div class="sage-kpi__meta">Carnet HT ÷ nombre de BC</div>
                        </article>
                        <article class="sage-kpi sage-kpi--pending">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">À préparer</span><div class="sage-kpi__icon sage-kpi__icon--warning"><i class="fas fa-box-open"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.to_prepare_count|number_format(0, ',', ' ') }}</div>
                            <div class="sage-kpi__meta"><strong>{{ sage.summary.to_prepare_amount_ht|number_format(2, ',', ' ') }} € HT</strong> · {{ sage.summary.to_prepare_share|number_format(1, ',', ' ') }} % des BC</div>
                            <div class="sage-kpi__bar"><div class="sage-kpi__bar-fill" style="width: {{ sage.summary.to_prepare_share }}%; background: var(--of-warning);"></div></div>
                        </article>
                    {% elseif sage.filters.document_scope == 'invoices' %}
                        <article class="sage-kpi sage-kpi--invoice">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">CA comptabilisé net HT</span><div class="sage-kpi__icon sage-kpi__icon--invoice"><i class="fas fa-chart-line"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.posted_revenue_ht|number_format(2, ',', ' ') }}<span class="sage-kpi__currency">€</span></div>
                            <div class="sage-kpi__meta">Factures type 7, avoirs déduits</div>
                        </article>
                        <article class="sage-kpi sage-kpi--invoice">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">CA comptabilisé net TTC</span><div class="sage-kpi__icon sage-kpi__icon--invoice"><i class="fas fa-euro-sign"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.posted_revenue_ttc|number_format(2, ',', ' ') }}<span class="sage-kpi__currency">€</span></div>
                            <div class="sage-kpi__meta">Montant TTC net comptabilisé</div>
                        </article>
                        <article class="sage-kpi sage-kpi--invoice">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">Documents de facturation</span><div class="sage-kpi__icon sage-kpi__icon--invoice"><i class="fas fa-file-invoice-dollar"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.invoice_count|number_format(0, ',', ' ') }}</div>
                            <div class="sage-kpi__meta">{{ sage.summary.posted_invoice_count }} comptabilisés · {{ sage.summary.pending_invoice_count }} en attente</div>
                        </article>
                        <article class="sage-kpi sage-kpi--pending">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">À comptabiliser HT</span><div class="sage-kpi__icon sage-kpi__icon--warning"><i class="fas fa-clock"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.pending_invoice_amount_ht|number_format(2, ',', ' ') }}<span class="sage-kpi__currency">€</span></div>
                            <div class="sage-kpi__meta">{{ sage.summary.pending_invoice_count }} document{{ sage.summary.pending_invoice_count > 1 ? 's' : '' }} type 6</div>
                        </article>
                        <article class="sage-kpi sage-kpi--credit">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">Avoirs détectés</span><div class="sage-kpi__icon sage-kpi__icon--danger"><i class="fas fa-rotate-left"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.credit_count|number_format(0, ',', ' ') }}</div>
                            <div class="sage-kpi__meta">Documents négatifs déjà intégrés au net</div>
                        </article>
                    {% else %}
                        <article class="sage-kpi sage-kpi--invoice">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">CA comptabilisé net HT</span><div class="sage-kpi__icon sage-kpi__icon--invoice"><i class="fas fa-chart-line"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.posted_revenue_ht|number_format(2, ',', ' ') }}<span class="sage-kpi__currency">€</span></div>
                            <div class="sage-kpi__meta">{{ sage.summary.posted_invoice_count }} documents comptabilisés · avoirs déduits</div>
                        </article>
                        <article class="sage-kpi sage-kpi--order">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">Carnet de commandes HT</span><div class="sage-kpi__icon sage-kpi__icon--accent"><i class="fas fa-file-signature"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.ordered_amount_ht|number_format(2, ',', ' ') }}<span class="sage-kpi__currency">€</span></div>
                            <div class="sage-kpi__meta">{{ sage.summary.order_count }} commandes BC, non ajoutées au CA</div>
                        </article>
                        <article class="sage-kpi sage-kpi--pending">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">À comptabiliser HT</span><div class="sage-kpi__icon sage-kpi__icon--warning"><i class="fas fa-clock"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.pending_invoice_amount_ht|number_format(2, ',', ' ') }}<span class="sage-kpi__currency">€</span></div>
                            <div class="sage-kpi__meta">{{ sage.summary.pending_invoice_count }} factures / avoirs en attente</div>
                        </article>
                        <article class="sage-kpi sage-kpi--mixed">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">Documents suivis</span><div class="sage-kpi__icon sage-kpi__icon--info"><i class="fas fa-layer-group"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.document_count|number_format(0, ',', ' ') }}</div>
                            <div class="sage-kpi__meta"><strong class="sage-text-order">{{ sage.summary.order_count }} BC</strong> · <strong class="sage-text-invoice">{{ sage.summary.invoice_count }} factures / avoirs</strong></div>
                        </article>
                        <article class="sage-kpi sage-kpi--invoice">
                            <div class="sage-kpi__head"><span class="sage-kpi__label">Factures suivies</span><div class="sage-kpi__icon sage-kpi__icon--invoice"><i class="fas fa-file-invoice-dollar"></i></div></div>
                            <div class="sage-kpi__value">{{ sage.summary.invoice_count|number_format(0, ',', ' ') }}</div>
                            <div class="sage-kpi__meta">{{ sage.summary.posted_invoice_count }} comptabilisées · {{ sage.summary.pending_invoice_count }} en attente</div>
                        </article>
                    {% endif %}
                </div>

                {# ========== COMPARAISON PÉRIODE PRÉCÉDENTE ========== #}
                <div class="sage-card">
                    <div class="sage-card__header">
                        <div class="sage-card__title">
                            <span class="icon"><i class="fas fa-code-compare"></i></span>
                            Comparaison à la période précédente de même durée
                        </div>
                        {% if sage.comparison.enabled %}
                            <div class="sage-card__subtitle">
                                <strong>{{ sage.comparison.current_label }}</strong> vs {{ sage.comparison.previous_label }}
                            </div>
                        {% endif %}
                    </div>
                    <div class="sage-card__body">
                        {% if sage.comparison.enabled %}
                            <div class="sage-comparison">
                                {% for metric in sage.comparison.metrics %}
                                <article class="sage-metric">
                                    <span class="sage-metric__label">{{ metric.label }}</span>
                                    <strong class="sage-metric__value">
                                        {% if metric.format == 'currency' %}
                                            {{ metric.current|number_format(2, ',', ' ') }} €
                                        {% else %}
                                            {{ metric.current|number_format(0, ',', ' ') }}
                                        {% endif %}
                                    </strong>
                                    <small class="sage-metric__previous">
                                        Période précédente :
                                        {% if metric.format == 'currency' %}
                                            {{ metric.previous|number_format(2, ',', ' ') }} €
                                        {% else %}
                                            {{ metric.previous|number_format(0, ',', ' ') }}
                                        {% endif %}
                                    </small>
                                    <div class="sage-trend sage-trend--{{ metric.trend }}">
                                        {% if metric.trend == 'up' %}
                                            <i class="fas fa-arrow-up"></i>
                                        {% elseif metric.trend == 'down' %}
                                            <i class="fas fa-arrow-down"></i>
                                        {% else %}
                                            <i class="fas fa-minus"></i>
                                        {% endif %}
                                        <span>
                                            {% if metric.delta_percent is not null %}
                                                {{ metric.delta_percent > 0 ? '+' : '' }}{{ metric.delta_percent|number_format(1, ',', ' ') }}%
                                            {% else %}
                                                {% if metric.format == 'currency' %}
                                                    {{ metric.delta|number_format(2, ',', ' ') }} €
                                                {% else %}
                                                    {{ metric.delta|number_format(0, ',', ' ') }}
                                                {% endif %}
                                            {% endif %}
                                        </span>
                                    </div>
                                </article>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="sage-inline-note"><i class="fas fa-info-circle"></i>{{ sage.comparison.reason }}</div>
                        {% endif %}
                    </div>
                </div>

                {# ========== CHARTS PRINCIPAUX ========== #}
                <div class="sage-chart-grid">
                    <div class="sage-card">
                        <div class="sage-card__header">
                            <div class="sage-card__title">
                                <span class="icon"><i class="fas fa-chart-area"></i></span>
                                Évolution des montants HT
                            </div>
                            <div class="sage-card__subtitle">Séries séparées · {{ sage.filters.group_by == 'year' ? 'vue annuelle' : 'vue mensuelle' }}</div>
                        </div>
                        <div class="sage-card__body">
                            <div class="sage-chart-canvas">
                                <canvas id="erpAmountChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="sage-chart-stack">
                        <div class="sage-card">
                            <div class="sage-card__header">
                                <div class="sage-card__title">
                                    <span class="icon"><i class="fas fa-users"></i></span>
                                    Activité HT par commercial
                                </div>
                            </div>
                            <div class="sage-card__body">
                                <div class="sage-chart-canvas sage-chart-canvas--sm">
                                    <canvas id="erpCommercialChart"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="sage-card">
                            <div class="sage-card__header">
                                <div class="sage-card__title">
                                    <span class="icon"><i class="fas fa-chart-pie"></i></span>
                                    Statuts par famille de document
                                </div>
                            </div>
                            <div class="sage-card__body">
                                <div class="sage-status-charts">
                                    {% if sage.filters.document_scope != 'invoices' %}
                                        <div class="sage-status-chart">
                                            <strong><span class="sage-legend-dot sage-legend-dot--order"></span>Commandes BC</strong>
                                            <div class="sage-chart-canvas sage-chart-canvas--status"><canvas id="erpOrderStatusChart"></canvas></div>
                                        </div>
                                    {% endif %}
                                    {% if sage.filters.document_scope != 'orders' %}
                                        <div class="sage-status-chart">
                                            <strong><span class="sage-legend-dot sage-legend-dot--invoice"></span>Factures / avoirs</strong>
                                            <div class="sage-chart-canvas sage-chart-canvas--status"><canvas id="erpInvoiceStatusChart"></canvas></div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ========== TOP CLIENTS ========== #}
                <div class="sage-chart-grid">
                    <div class="sage-card">
                        <div class="sage-card__header">
                            <div class="sage-card__title">
                                <span class="icon"><i class="fas fa-medal"></i></span>
                                Top clients
                            </div>
                            <div class="sage-card__subtitle">{{ sage.filters.document_scope == 'orders' ? 'Classement par carnet BC' : 'Classement par facturation nette' }}</div>
                        </div>
                        <div class="sage-card__body">
                            <div class="sage-chart-canvas sage-chart-canvas--sm">
                                <canvas id="erpClientChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="sage-card">
                        <div class="sage-card__header">
                            <div class="sage-card__title">
                                <span class="icon"><i class="fas fa-list-ol"></i></span>
                                Détail top clients
                            </div>
                        </div>
                        <div class="sage-card__body sage-card__body--flush">
                            <table class="sage-table">
                                <thead>
                                    <tr>
                                        <th>Client</th>
                                        {% if sage.filters.document_scope != 'invoices' %}
                                            <th style="text-align:right;">BC</th>
                                            <th style="text-align:right;">BC HT</th>
                                        {% endif %}
                                        {% if sage.filters.document_scope != 'orders' %}
                                            <th style="text-align:right;">Fact.</th>
                                            <th style="text-align:right;">Facturation HT</th>
                                        {% endif %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in sage.topClients %}
                                        <tr>
                                            <td>
                                                <strong>{{ item.name }}</strong>
                                                {% if item.tiers != '' and item.tiers != item.name %}
                                                    <span class="sage-table__sub">{{ item.tiers }}</span>
                                                {% endif %}
                                            </td>
                                            {% if sage.filters.document_scope != 'invoices' %}
                                                <td class="sage-table__num" style="text-align:right;">{{ item.order_count }}</td>
                                                <td class="sage-table__amount sage-text-order" style="text-align:right;">{{ item.order_amount_ht|number_format(2, ',', ' ') }} €</td>
                                            {% endif %}
                                            {% if sage.filters.document_scope != 'orders' %}
                                                <td class="sage-table__num" style="text-align:right;">{{ item.invoice_count }}</td>
                                                <td class="sage-table__amount sage-text-invoice" style="text-align:right;">{{ item.invoice_amount_ht|number_format(2, ',', ' ') }} €</td>
                                            {% endif %}
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="{{ sage.filters.document_scope == 'all' ? 5 : 3 }}">
                                                <div class="sage-empty">
                                                    <div class="sage-empty__icon"><i class="fas fa-inbox"></i></div>
                                                    Aucune donnée client disponible
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# ========== VOLUME + TOP COMMERCIAUX ========== #}
                <div class="sage-chart-grid">
                    <div class="sage-card">
                        <div class="sage-card__header">
                            <div class="sage-card__title">
                                <span class="icon"><i class="fas fa-chart-bar"></i></span>
                                Volume des documents
                            </div>
                            <div class="sage-card__subtitle">BC et factures comptés séparément</div>
                        </div>
                        <div class="sage-card__body">
                            <div class="sage-chart-canvas sage-chart-canvas--sm">
                                <canvas id="erpVolumeChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="sage-card">
                        <div class="sage-card__header">
                            <div class="sage-card__title">
                                <span class="icon"><i class="fas fa-award"></i></span>
                                Top commerciaux
                            </div>
                        </div>
                        <div class="sage-card__body sage-card__body--flush">
                            <table class="sage-table">
                                <thead>
                                    <tr>
                                        <th>Commercial</th>
                                        {% if sage.filters.document_scope != 'invoices' %}
                                            <th style="text-align:right;">BC</th>
                                            <th style="text-align:right;">BC HT</th>
                                        {% endif %}
                                        {% if sage.filters.document_scope != 'orders' %}
                                            <th style="text-align:right;">Fact.</th>
                                            <th style="text-align:right;">Facturation HT</th>
                                        {% endif %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in sage.topCommercials %}
                                        <tr>
                                            <td><strong>{{ item.name }}</strong></td>
                                            {% if sage.filters.document_scope != 'invoices' %}
                                                <td class="sage-table__num" style="text-align:right;">{{ item.order_count }}</td>
                                                <td class="sage-table__amount sage-text-order" style="text-align:right;">{{ item.order_amount_ht|number_format(2, ',', ' ') }} €</td>
                                            {% endif %}
                                            {% if sage.filters.document_scope != 'orders' %}
                                                <td class="sage-table__num" style="text-align:right;">{{ item.invoice_count }}</td>
                                                <td class="sage-table__amount sage-text-invoice" style="text-align:right;">{{ item.invoice_amount_ht|number_format(2, ',', ' ') }} €</td>
                                            {% endif %}
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="{{ sage.filters.document_scope == 'all' ? 5 : 3 }}">
                                                <div class="sage-empty">
                                                    <div class="sage-empty__icon"><i class="fas fa-user-slash"></i></div>
                                                    Aucune donnée commerciale
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# ========== DOCUMENTS + DETAIL ========== #}
                <div class="sage-table-grid">
                    <div class="sage-card">
                        <div class="sage-card__header">
                            <div class="sage-card__title">
                                <span class="icon"><i class="fas fa-receipt"></i></span>
                                Activité récente
                            </div>
                            <div class="sage-card__subtitle">Détail instantané, sans rechargement</div>
                        </div>
                        <div class="sage-card__body sage-card__body--flush">
                            <table class="sage-table">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Pièce</th>
                                        <th>Date</th>
                                        <th>Client</th>
                                        <th>Commercial</th>
                                        <th>Statut</th>
                                        <th style="text-align:right;">Montant HT</th>
                                        <th style="text-align:right;">Montant TTC</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for document in sage.recentDocuments %}
                                        <tr class="{{ sage.filters.selected_piece == document.piece and sage.filters.selected_type == document.document_type ? 'is-selected' : '' }}" data-document-row>
                                            <td><span class="sage-document-badge sage-document-badge--{{ document.category }}">{{ document.type_label }}</span></td>
                                            <td>
                                                <a class="sage-piece-link" href="{{ path('supervision_statistics_index', {
                                                    period: sage.filters.period,
                                                    group_by: sage.filters.group_by,
                                                    document_scope: sage.filters.document_scope,
                                                    invoice_state: sage.filters.invoice_state,
                                                    date_debut: sage.filters.date_debut,
                                                    date_fin: sage.filters.date_fin,
                                                    representant: sage.filters.representant,
                                                    piece: sage.filters.piece,
                                                    selected_piece: document.piece,
                                                    selected_type: document.document_type
                                                }) }}" data-turbo="false" data-document-detail-url="{{ path('supervision_statistics_document_detail', {type: document.document_type, piece: document.piece}) }}">
                                                    {{ document.piece }}
                                                </a>
                                            </td>
                                            <td>{{ document.date_label }}</td>
                                            <td>
                                                <strong>{{ document.company_name != '' ? document.company_name : document.tiers }}</strong>
                                                <span class="sage-table__sub">{{ document.tiers }}</span>
                                            </td>
                                            <td>{{ document.representant != '' ? document.representant : '—' }}</td>
                                            <td>
                                                <span class="sage-badge {{ document.statut == 'À préparer' or document.statut == 'A comptabiliser' ? 'sage-badge--warning' : 'sage-badge--neutral' }}">{{ document.statut != '' ? document.statut : 'N/A' }}</span>
                                            </td>
                                            <td class="sage-table__amount" style="text-align:right;">{{ document.montantHT|number_format(2, ',', ' ') }} €</td>
                                            <td class="sage-table__amount" style="text-align:right;">{{ document.montantTTC|number_format(2, ',', ' ') }} €</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="8">
                                                <div class="sage-empty">
                                                    <div class="sage-empty__icon"><i class="fas fa-search"></i></div>
                                                    Aucun document sur ces filtres
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="sage-card sage-document-detail-card" id="sageDocumentDetail" aria-live="polite">
                        {% include 'supervision/statistics/_document_detail.html.twig' with {
                            selectedDocument: sage.selectedDocument,
                            selectedLines: sage.selectedLines,
                            detailError: null
                        } only %}
                    </div>
                </div>

            {% endif %}
        </section>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if sageStatistics %}
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
        <script>
            (() => {
                // ===== PALETTE alignée sur les variables CSS =====
                const palette = {
                    primary: '#1A1F3C',
                    secondary: '#2B3160',
                    accent: '#00C2A8',
                    accentSoft: 'rgba(0, 194, 168, 0.14)',
                    chart: ['#00C2A8', '#2B3160', '#3B82F6', '#F59E0B', '#9B5DE5', '#10B981', '#E53E3E', '#71C4EF']
                };

                // ===== Defaults Chart.js =====
                if (typeof Chart !== 'undefined') {
                    Chart.defaults.font.family = "'Inter', sans-serif";
                    Chart.defaults.font.size = 12;
                    Chart.defaults.color = 'rgba(26, 31, 60, 0.65)';
                    Chart.defaults.plugins.tooltip.backgroundColor = '#1A1F3C';
                    Chart.defaults.plugins.tooltip.titleFont = { weight: '600', size: 12 };
                    Chart.defaults.plugins.tooltip.bodyFont = { size: 12 };
                    Chart.defaults.plugins.tooltip.padding = 12;
                    Chart.defaults.plugins.tooltip.cornerRadius = 8;
                    Chart.defaults.plugins.tooltip.displayColors = false;
                    Chart.defaults.plugins.tooltip.boxPadding = 6;
                }

                const amountData = {{ sageStatistics.charts.amounts|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
                const volumeData = {{ sageStatistics.charts.volumes|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
                const commercialData = {{ sageStatistics.charts.commercials|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
                const clientData = {{ sageStatistics.charts.clients|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
                const statusData = {{ sageStatistics.charts.statuses|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};

                window.erpSageCharts = window.erpSageCharts || {};

                const fmtCurrency = (value) => new Intl.NumberFormat('fr-FR', {
                    style: 'currency',
                    currency: 'EUR',
                    maximumFractionDigits: 2
                }).format(value);

                const fmtCompact = (value) => {
                    if (Math.abs(value) >= 1e6) return (value / 1e6).toFixed(1).replace('.0', '') + 'M€';
                    if (Math.abs(value) >= 1e3) return (value / 1e3).toFixed(1).replace('.0', '') + 'k€';
                    return value + '€';
                };

                const resetChart = (key) => {
                    if (window.erpSageCharts[key]) {
                        window.erpSageCharts[key].destroy();
                        delete window.erpSageCharts[key];
                    }
                };

                const documentColors = {
                    order: '#00C2A8',
                    pending_invoice: '#F59E0B',
                    posted_invoice: '#6D5BD0'
                };

                const buildBarDatasets = (datasets, maxBarThickness = 28) => datasets.map(dataset => ({
                    ...dataset,
                    backgroundColor: documentColors[dataset.key] || palette.secondary,
                    hoverBackgroundColor: palette.secondary,
                    borderRadius: 6,
                    borderSkipped: false,
                    barThickness: 'flex',
                    maxBarThickness
                }));

                const currencyTooltip = (axis) => ({
                    callbacks: {
                        label: (context) => `  ${context.dataset.label} : ${fmtCurrency(axis === 'x' ? context.parsed.x || 0 : context.parsed.y || 0)}`
                    }
                });

                const renderCharts = () => {
                    if (typeof Chart === 'undefined') return;

                    resetChart('amounts');
                    resetChart('volumes');
                    resetChart('commercials');
                    resetChart('clients');
                    resetChart('orderStatuses');
                    resetChart('invoiceStatuses');

                    // ===== AMOUNTS BY DOCUMENT TYPE =====
                    const amountCanvas = document.getElementById('erpAmountChart');
                    if (amountCanvas) {
                        window.erpSageCharts.amounts = new Chart(amountCanvas, {
                            type: 'bar',
                            data: {
                                labels: amountData.labels,
                                datasets: buildBarDatasets(amountData.datasets)
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                interaction: { mode: 'index', intersect: false },
                                plugins: {
                                    legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 14 } },
                                    tooltip: currencyTooltip('y')
                                },
                                scales: {
                                    x: { grid: { display: false }, border: { display: false } },
                                    y: {
                                        beginAtZero: true,
                                        grid: { color: 'rgba(26, 31, 60, 0.06)' },
                                        border: { display: false },
                                        ticks: { callback: (v) => fmtCompact(v) }
                                    }
                                }
                            }
                        });
                    }

                    // ===== DOCUMENT VOLUMES =====
                    const volumeCanvas = document.getElementById('erpVolumeChart');
                    if (volumeCanvas) {
                        window.erpSageCharts.volumes = new Chart(volumeCanvas, {
                            type: 'bar',
                            data: {
                                labels: volumeData.labels,
                                datasets: buildBarDatasets(volumeData.datasets, 24)
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 12 } },
                                    tooltip: {
                                        callbacks: {
                                            label: (context) => `  ${context.dataset.label} : ${context.parsed.y || 0}`
                                        }
                                    }
                                },
                                scales: {
                                    x: { grid: { display: false }, border: { display: false } },
                                    y: {
                                        beginAtZero: true,
                                        grid: { color: 'rgba(26, 31, 60, 0.06)' },
                                        border: { display: false },
                                        ticks: { precision: 0 }
                                    }
                                }
                            }
                        });
                    }

                    // ===== COMMERCIALS (horizontal bars) =====
                    const commercialCanvas = document.getElementById('erpCommercialChart');
                    if (commercialCanvas) {
                        window.erpSageCharts.commercials = new Chart(commercialCanvas, {
                            type: 'bar',
                            data: {
                                labels: commercialData.labels,
                                datasets: buildBarDatasets(commercialData.datasets, 16)
                            },
                            options: {
                                indexAxis: 'y',
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 10, font: { size: 10 } } },
                                    tooltip: currencyTooltip('x')
                                },
                                scales: {
                                    x: {
                                        beginAtZero: true,
                                        grid: { color: 'rgba(26, 31, 60, 0.06)' },
                                        border: { display: false },
                                        ticks: { callback: (v) => fmtCompact(v) }
                                    },
                                    y: { grid: { display: false }, border: { display: false } }
                                }
                            }
                        });
                    }

                    // ===== CLIENTS (horizontal bars) =====
                    const clientCanvas = document.getElementById('erpClientChart');
                    if (clientCanvas) {
                        window.erpSageCharts.clients = new Chart(clientCanvas, {
                            type: 'bar',
                            data: {
                                labels: clientData.labels,
                                datasets: buildBarDatasets(clientData.datasets, 16)
                            },
                            options: {
                                indexAxis: 'y',
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 10, font: { size: 10 } } },
                                    tooltip: currencyTooltip('x')
                                },
                                scales: {
                                    x: {
                                        beginAtZero: true,
                                        grid: { color: 'rgba(26, 31, 60, 0.06)' },
                                        border: { display: false },
                                        ticks: { callback: (v) => fmtCompact(v) }
                                    },
                                    y: { grid: { display: false }, border: { display: false } }
                                }
                            }
                        });
                    }

                    // ===== STATUSES, KEPT SEPARATE BY FAMILY =====
                    const renderStatusChart = (key, canvasId, data, family) => {
                        const canvas = document.getElementById(canvasId);
                        if (!canvas || data.labels.length === 0) return;

                        const colors = data.labels.map((label, index) => {
                            if (family === 'order') return label === 'À préparer' ? '#F59E0B' : ['#00C2A8', '#2B3160', '#3B82F6'][index % 3];
                            if (label === 'A comptabiliser') return '#F59E0B';
                            if (label === 'Comptabilisé') return '#6D5BD0';
                            return ['#6D5BD0', '#9B5DE5', '#E53E3E'][index % 3];
                        });

                        window.erpSageCharts[key] = new Chart(canvas, {
                            type: 'doughnut',
                            data: {
                                labels: data.labels,
                                datasets: [{
                                    data: data.data,
                                    backgroundColor: colors,
                                    borderWidth: 3,
                                    borderColor: '#fff',
                                    hoverOffset: 8
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                cutout: '65%',
                                plugins: {
                                    legend: {
                                        position: 'bottom',
                                        labels: {
                                            padding: 14,
                                            usePointStyle: true,
                                            pointStyle: 'circle',
                                            font: { size: 11, weight: '500' }
                                        }
                                    }
                                }
                            }
                        });
                    };

                    renderStatusChart('orderStatuses', 'erpOrderStatusChart', statusData.orders, 'order');
                    renderStatusChart('invoiceStatuses', 'erpInvoiceStatusChart', statusData.invoices, 'invoice');
                };

                // ===== Period chips → sync select + auto-submit =====
                const setupPeriodChips = () => {
                    const chips = document.querySelectorAll('.sage-period-chip');
                    const periodSelect = document.getElementById('period');
                    const form = document.getElementById('sageFiltersForm');
                    const dateInputs = document.querySelectorAll('#date_debut, #date_fin');

                    const activatePeriod = (value) => {
                        chips.forEach(chip => {
                            const isActive = chip.dataset.period === value;
                            chip.classList.toggle('is-active', isActive);
                            chip.setAttribute('aria-selected', isActive ? 'true' : 'false');
                        });
                        if (periodSelect) periodSelect.value = value;
                    };

                    chips.forEach(chip => {
                        chip.addEventListener('click', () => {
                            const value = chip.dataset.period;
                            activatePeriod(value);
                            if (value !== 'custom' && form) form.requestSubmit();
                        });
                    });

                    periodSelect?.addEventListener('change', () => activatePeriod(periodSelect.value));
                    dateInputs.forEach(input => input.addEventListener('change', () => activatePeriod('custom')));
                };

                const setupFilterFeedback = () => {
                    const form = document.getElementById('sageFiltersForm');
                    const filters = form?.closest('.sage-filters');
                    const submitButton = form?.querySelector('button[type="submit"]');

                    if (!form || !filters || !submitButton) return;
                    const submitLabel = submitButton.innerHTML;

                    form.addEventListener('submit', () => {
                        filters.classList.add('is-loading');
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Chargement Sage…';
                    });

                    form.addEventListener('turbo:submit-end', () => {
                        filters.classList.remove('is-loading');
                        submitButton.disabled = false;
                        submitButton.innerHTML = submitLabel;
                    });
                };

                const setupDocumentScope = () => {
                    const form = document.getElementById('sageFiltersForm');
                    if (!form) return;

                    form.querySelectorAll('input[name="document_scope"]').forEach(input => {
                        input.addEventListener('change', () => form.requestSubmit());
                    });
                    form.querySelector('#invoice_state')?.addEventListener('change', () => form.requestSubmit());
                };

                const setupDocumentDetails = () => {
                    const detailCard = document.getElementById('sageDocumentDetail');
                    const links = document.querySelectorAll('.sage-piece-link[data-document-detail-url]');
                    let activeRequest = null;

                    if (!detailCard || links.length === 0) return;

                    links.forEach(link => {
                        link.addEventListener('click', async (event) => {
                            event.preventDefault();
                            activeRequest?.abort();
                            const request = new AbortController();
                            activeRequest = request;

                            document.querySelectorAll('[data-document-row]').forEach(row => row.classList.remove('is-selected'));
                            link.closest('[data-document-row]')?.classList.add('is-selected');
                            detailCard.setAttribute('aria-busy', 'true');
                            detailCard.innerHTML = `
                                <div class="sage-document-loading" role="status">
                                    <div><i class="fas fa-circle-notch fa-spin"></i>Chargement du document Sage…</div>
                                </div>
                            `;

                            try {
                                const response = await fetch(link.dataset.documentDetailUrl, {
                                    headers: {'X-Requested-With': 'XMLHttpRequest'},
                                    signal: request.signal
                                });
                                const html = await response.text();

                                if (html.trim() === '') throw new Error('Empty response');

                                detailCard.innerHTML = html;

                                if (response.ok) {
                                    window.history.replaceState({}, '', link.href);
                                }

                                if (window.matchMedia('(max-width: 1120px)').matches) {
                                    detailCard.scrollIntoView({behavior: 'smooth', block: 'start'});
                                }
                            } catch (error) {
                                if (error.name === 'AbortError') return;

                                detailCard.innerHTML = `
                                    <div class="sage-card__header">
                                        <div class="sage-card__title"><span class="icon"><i class="fas fa-file-invoice"></i></span>Détail du document Sage</div>
                                    </div>
                                    <div class="sage-card__body">
                                        <div class="sage-detail-error" role="alert">
                                            <i class="fas fa-circle-exclamation"></i>
                                            <div><strong>Détail indisponible</strong><span>La communication avec Sage a échoué. Réessayez dans quelques instants.</span></div>
                                        </div>
                                    </div>
                                `;
                            } finally {
                                if (activeRequest === request) {
                                    activeRequest = null;
                                    detailCard.removeAttribute('aria-busy');
                                }
                            }
                        });
                    });
                };

                document.addEventListener('turbo:before-cache', () => {
                    resetChart('amounts');
                    resetChart('volumes');
                    resetChart('commercials');
                    resetChart('clients');
                    resetChart('orderStatuses');
                    resetChart('invoiceStatuses');
                }, { once: true });

                const init = () => {
                    renderCharts();
                    setupPeriodChips();
                    setupFilterFeedback();
                    setupDocumentScope();
                    setupDocumentDetails();
                };

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', init, { once: true });
                } else {
                    init();
                }
            })();
        </script>
    {% endif %}
{% endblock %}
