{% extends 'base.html.twig' %}

{% block title %}Connexion | LSTRADE Extranet{% endblock %}

{% block body %}
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            font-family: var(--font-sans);
            background:
                radial-gradient(circle at top left, rgba(0, 194, 168, 0.14), transparent 28%),
                radial-gradient(circle at bottom right, rgba(26, 31, 60, 0.12), transparent 32%),
                linear-gradient(135deg, #f4f5f9 0%, #eef2f7 100%);
            color: var(--text-primary);
        }

        .login-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
        }

        .login-brand {
            background: linear-gradient(160deg, var(--color-brand-primary) 0%, var(--color-brand-secondary) 100%);
            color: var(--text-on-dark);
            padding: var(--space-16);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .login-brand::before,
        .login-brand::after {
            content: '';
            position: absolute;
            border-radius: 9999px;
            background: rgba(0, 194, 168, 0.08);
        }

        .login-brand::before {
            width: 320px;
            height: 320px;
            top: -120px;
            right: -80px;
        }

        .login-brand::after {
            width: 220px;
            height: 220px;
            bottom: -90px;
            left: -60px;
        }

        .brand-lockup,
        .brand-footer {
            position: relative;
            z-index: 1;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
            padding: var(--space-2) var(--space-3);
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: var(--border-radius-full);
            color: rgba(255, 255, 255, 0.84);
            font-size: var(--text-xs);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .brand-title {
            margin: var(--space-8) 0 var(--space-4);
            color:#eef2f7;
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            line-height: 0.95;
            letter-spacing: -0.04em;
        }

        .brand-copy {
            max-width: 32rem;
            color: rgba(255, 255, 255, 0.72);
            font-size: var(--text-lg);
            line-height: 1.6;
        }

        .brand-footer {
            display: grid;
            gap: var(--space-4);
            max-width: 26rem;
        }

        .brand-point {
            display: flex;
            gap: var(--space-3);
            align-items: flex-start;
            color: rgba(255, 255, 255, 0.74);
            font-size: var(--text-sm);
        }

        .brand-point i {
            color: var(--color-brand-accent);
            margin-top: 2px;
        }

        .login-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: var(--space-8);
        }

        .login-card {
            width: min(100%, 420px);
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 28px;
            box-shadow: 0 24px 60px rgba(26, 31, 60, 0.12);
            padding: var(--space-10);
        }

        .login-card h1 {
            margin: 0 0 var(--space-3);
            font-size: var(--text-3xl);
        }

        .login-card p {
            margin: 0 0 var(--space-8);
            color: var(--text-secondary);
            line-height: 1.6;
        }

        .login-alert {
            margin-bottom: var(--space-6);
            padding: var(--space-4);
            border-radius: var(--border-radius-md);
            font-size: var(--text-sm);
        }

        .login-alert--error {
            background: var(--color-error-bg);
            color: var(--color-error);
            border: 1px solid rgba(232, 57, 77, 0.18);
        }

        .login-alert--info {
            background: var(--color-info-bg);
            color: var(--color-info);
            border: 1px solid rgba(59, 130, 246, 0.14);
        }

        .login-form {
            display: grid;
            gap: var(--space-5);
        }

        .login-field {
            display: grid;
            gap: var(--space-2);
        }

        .login-field label {
            font-size: var(--text-sm);
            font-weight: var(--font-semibold);
        }

        .login-field input {
            width: 100%;
            box-sizing: border-box;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 0.95rem 1rem;
            font-size: var(--text-base);
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.95);
        }

        .login-field input:focus {
            outline: none;
            border-color: var(--color-brand-accent);
            box-shadow: 0 0 0 4px rgba(0, 194, 168, 0.12);
        }

        .login-submit {
            width: 100%;
            border: none;
            border-radius: 14px;
            padding: 1rem 1.2rem;
            font-size: var(--text-sm);
            font-weight: var(--font-semibold);
            color: var(--text-on-dark);
            background: linear-gradient(135deg, var(--color-brand-accent) 0%, var(--color-brand-accent-hover) 100%);
            box-shadow: 0 16px 28px rgba(0, 194, 168, 0.22);
            cursor: pointer;
        }

        .login-footnote {
            margin-top: var(--space-6);
            font-size: var(--text-xs);
            color: var(--text-muted);
            text-align: center;
        }

        @media (max-width: 960px) {
            .login-shell {
                grid-template-columns: 1fr;
            }

            .login-brand {
                min-height: 320px;
                padding: var(--space-10);
            }

            .login-panel {
                padding: var(--space-6);
                margin-top: -64px;
                position: relative;
                z-index: 1;
            }
        }
    </style>

    <div class="login-shell">
        <section class="login-brand">
            <div class="brand-lockup">
                <span class="brand-badge">LSTRADE Extranet</span>
                <h1 class="brand-title">Flux HubSpot<br>et Sage</h1>
                <p class="brand-copy">Accedez a l espace de synchronisation des clients, produits, commandes et stocks depuis une interface securisee.</p>
            </div>

            <div class="brand-footer">
                <div class="brand-point">
                    <i class="fas fa-shield-alt"></i>
                    <span>Les routes de supervision et de synchronisation sont reservees aux utilisateurs authentifies.</span>
                </div>
                <div class="brand-point">
                    <i class="fas fa-exchange-alt"></i>
                    <span>Un seul point d acces pour piloter vos flux HubSpot vers Sage et Sage vers HubSpot.</span>
                </div>
            </div>
        </section>

        <section class="login-panel">
            <div class="login-card">
                <h1>Connexion</h1>
                <p>Identifiez-vous pour acceder aux pages de flux et lancer les synchronisations.</p>

                {% if error %}
                    <div class="login-alert login-alert--error">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="login-alert login-alert--info">
                        Vous etes deja connecte en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                    </div>
                {% endif %}

                <form method="post" class="login-form">
                    <div class="login-field">
                        <label for="username">Identifiant</label>
                        <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                    </div>

                    <div class="login-field">
                        <label for="password">Mot de passe</label>
                        <input type="password" id="password" name="_password" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button class="login-submit" type="submit">Se connecter</button>
                </form>

                <p class="login-footnote">Identifiants definis via <code>APP_LOGIN_USERNAME</code> et <code>APP_LOGIN_PASSWORD</code>.</p>
            </div>
        </section>
    </div>
{% endblock %}
