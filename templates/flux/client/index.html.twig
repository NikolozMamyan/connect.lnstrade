{% extends 'layout/app.html.twig' %}

{% block page_title %}{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block content %}
<style>
    /* ── Notification ──────────────────────────────────────────── */
    .flash-notif {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3) var(--space-4);
        border-radius: var(--border-radius-md);
        margin-bottom: var(--space-5);
        font-size: var(--text-sm);
        animation: slideInDown 0.25s ease-out;
    }
    .flash-notif--success {
        background: var(--color-success-bg);
        color: var(--color-success);
        border-left: 3px solid var(--color-success);
    }
    .flash-notif--error {
        background: var(--color-error-bg);
        color: var(--color-error);
        border-left: 3px solid var(--color-error);
    }
    .flash-notif i { font-size: var(--text-base); flex-shrink: 0; }

    /* ── Header ────────────────────────────────────────────────── */
    .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-4);
        margin-bottom: var(--space-6);
        flex-wrap: wrap;
    }
    .page-header__title {
        font-size: var(--text-xl);
        font-weight: var(--font-semibold);
        color: var(--text-primary);
        margin: 0 0 var(--space-1) 0;
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }
    .page-header__title i {
        color: var(--color-brand-accent);
        font-size: var(--text-lg);
    }
    .page-header__sub {
        font-size: var(--text-xs);
        color: var(--text-muted);
        margin: 0;
    }

    /* ── Stats bar ─────────────────────────────────────────────── */
    .stats-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: var(--space-2);
        margin-bottom: var(--space-5);
    }
    .stat-card {
        background: var(--bg-base);
        border-radius: var(--border-radius-md);
        padding: var(--space-3) var(--space-4);
    }
    .stat-card__label {
        font-size: var(--text-xs);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: var(--space-1);
    }
    .stat-card__value {
        font-size: var(--text-2xl);
        font-weight: var(--font-semibold);
        color: var(--text-primary);
    }
    .stat-card__value--accent { color: var(--color-brand-accent); }
    .stat-card__value--success { color: var(--color-success); }
    .stat-card__value--warning { color: var(--color-warning, #f59e0b); }

    /* ── Search row ────────────────────────────────────────────── */
    .search-row {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        margin-bottom: var(--space-4);
        flex-wrap: wrap;
    }
    .search-wrap {
        position: relative;
        flex: 1;
        min-width: 220px;
    }
    .search-wrap i {
        position: absolute;
        left: var(--space-3);
        top: 50%;
        transform: translateY(-50%);
        font-size: var(--text-sm);
        color: var(--text-muted);
        pointer-events: none;
    }
    .search-wrap input {
        width: 100%;
        padding: var(--space-2) var(--space-3) var(--space-2) var(--space-9);
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--border-radius-md);
        font-size: var(--text-sm);
        color: var(--text-primary);
        background: var(--bg-surface);
        transition: border-color var(--transition-fast);
    }
    .search-wrap input:focus {
        outline: none;
        border-color: var(--color-brand-accent);
        box-shadow: 0 0 0 3px var(--color-brand-accent-light);
    }
    .search-wrap input::placeholder { color: var(--text-muted); }
    .result-pill {
        white-space: nowrap;
        font-size: var(--text-xs);
        color: var(--text-secondary);
        padding: var(--space-2) var(--space-3);
        background: var(--bg-base);
        border-radius: var(--border-radius-md);
    }
    .result-pill__count {
        font-weight: var(--font-semibold);
        color: var(--color-brand-accent);
    }

    /* ── Empty state ───────────────────────────────────────────── */
    .empty-state {
        text-align: center;
        padding: var(--space-12) var(--space-6);
        background: var(--bg-surface);
        border-radius: var(--border-radius-lg);
        border: 2px dashed var(--border-color);
    }
    .empty-state i { font-size: 48px; color: var(--text-muted); display: block; margin-bottom: var(--space-3); }
    .empty-state p { font-size: var(--text-base); color: var(--text-secondary); margin: 0; }

    /* ── Table container ───────────────────────────────────────── */
    .table-container {
        background: var(--bg-surface);
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--border-radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }
    .table-wrapper { overflow-x: auto; }

    /* ── Companies table ───────────────────────────────────────── */
    .companies-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-sm);
        table-layout: fixed;
    }
    .companies-table thead {
        background: var(--bg-base);
        border-bottom: var(--border-width) solid var(--border-color);
    }
    .companies-table th {
        padding: var(--space-3) var(--space-4);
        text-align: left;
        font-size: var(--text-xs);
        font-weight: var(--font-semibold);
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }
    .companies-table th:first-child { padding-left: var(--space-5); width: 28%; }
    .companies-table th:nth-child(2) { width: 22%; }
    .companies-table th:nth-child(3) { width: 14%; }
    .companies-table th:nth-child(4) { width: 18%; }
    .companies-table th:nth-child(5) { width: 12%; }
    .companies-table th:last-child   { width: 6%; }

    .companies-table tbody tr {
        border-bottom: var(--border-width) solid var(--border-color);
        cursor: pointer;
        transition: background var(--transition-fast);
    }
    .companies-table tbody tr:last-child { border-bottom: none; }
    .companies-table tbody tr:hover:not(.expanded-row) { background: var(--bg-surface-hover); }

    .companies-table td {
        padding: var(--space-3) var(--space-4);
        color: var(--text-primary);
        vertical-align: middle;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .companies-table td:first-child { padding-left: var(--space-5); }

    /* ── Company name cell ─────────────────────────────────────── */
    .co-cell { display: flex; align-items: center; gap: var(--space-3); }
    .co-icon {
        width: 32px;
        height: 32px;
        background: var(--color-brand-accent-light);
        border-radius: var(--border-radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .co-icon i { color: var(--color-brand-accent); font-size: var(--text-sm); }
    .co-name {
        font-weight: var(--font-semibold);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* ── Meta (icon + text) ────────────────────────────────────── */
    .meta {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-xs);
        color: var(--text-secondary);
        overflow: hidden;
    }
    .meta i { font-size: var(--text-xs); color: var(--text-muted); flex-shrink: 0; }
    .meta span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .meta--empty { font-style: italic; color: var(--text-muted); font-size: var(--text-xs); }

    /* ── Contact badge ─────────────────────────────────────────── */
    .contacts-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--border-radius-full);
        font-size: var(--text-xs);
        font-weight: var(--font-medium);
    }
    .contacts-badge--has {
        background: var(--color-info-bg);
        color: var(--color-info);
    }
    .contacts-badge--empty {
        background: var(--bg-base);
        color: var(--text-muted);
    }

    /* ── Expand chevron ────────────────────────────────────────── */
    .chev {
        color: var(--text-muted);
        font-size: var(--text-sm);
        display: block;
        text-align: center;
        transition: transform var(--transition-fast);
    }
    .chev.open { transform: rotate(180deg); }

    /* ── Expanded row ──────────────────────────────────────────── */
    .expanded-row { display: none; }
    .expanded-row.show { display: table-row; }
    .expanded-row > td {
        background: var(--bg-base) !important;
        padding: 0 !important;
        border-bottom: var(--border-width) solid var(--border-color) !important;
    }
    .expanded-inner { padding: var(--space-4) var(--space-5) var(--space-5); }

    .expanded-title {
        font-size: var(--text-xs);
        font-weight: var(--font-semibold);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-secondary);
        margin: 0 0 var(--space-3) 0;
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }
    .expanded-title i { color: var(--color-brand-accent); }

    .contacts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: var(--space-2);
    }

    /* ── Contact card ──────────────────────────────────────────── */
    .contact-card {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3);
        background: var(--bg-surface);
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--border-radius-md);
        transition: border-color var(--transition-fast);
    }
    .contact-card:hover { border-color: var(--color-brand-accent); }
    .contact-avatar {
        width: 32px;
        height: 32px;
        border-radius: var(--border-radius-full);
        background: var(--color-brand-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-xs);
        font-weight: var(--font-semibold);
        color: #fff;
        flex-shrink: 0;
    }
    .contact-info { flex: 1; min-width: 0; }
    .contact-name {
        font-size: var(--text-sm);
        font-weight: var(--font-medium);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: 0 0 2px 0;
    }
    .contact-email {
        font-size: var(--text-xs);
        color: var(--text-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: 0;
    }
    .no-contacts { font-size: var(--text-sm); color: var(--text-muted); font-style: italic; }

    /* ── Animations ────────────────────────────────────────────── */
    @keyframes slideInDown {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Responsive ────────────────────────────────────────────── */
    @media (max-width: 1024px) {
        .companies-table th:nth-child(4),
        .companies-table td:nth-child(4) { display: none; }
    }
    @media (max-width: 768px) {
        .page-header { flex-direction: column; }
        .stats-bar { grid-template-columns: repeat(2, 1fr); }
        .companies-table th:nth-child(3),
        .companies-table td:nth-child(3) { display: none; }
        .contacts-grid { grid-template-columns: 1fr; }
    }
</style>

{# ── Flash messages ────────────────────────────────────────────── #}
{% for message in app.flashes('success') %}
    <div class="flash-notif flash-notif--success">
        <i class="fas fa-check-circle"></i>
        <span>{{ message }}</span>
    </div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="flash-notif flash-notif--error">
        <i class="fas fa-exclamation-circle"></i>
        <span>{{ message }}</span>
    </div>
{% endfor %}

{# ── Tabs ──────────────────────────────────────────────────────── #}
{% include 'partials/flux_tabs.html.twig' with { flux: 'client' } %}

{# ── Header ────────────────────────────────────────────────────── #}
<div class="page-header">
    <div>
        <h1 class="page-header__title">
            <i class="fas fa-exchange-alt"></i>
            Flux Client — Logs
        </h1>
        <p class="page-header__sub">{{ companies|length }} entreprise{{ companies|length != 1 ? 's' : '' }} synchronisée{{ companies|length != 1 ? 's' : '' }}</p>
    </div>
    <form method="post" action="{{ path('flux_client_sync') }}"
          onsubmit="this.querySelector('button[type=submit]').disabled = true;">
        {{ include('ui/button.html.twig', {
            label: 'Lancer la synchronisation',
            variant: 'primary',
            type: 'submit',
            icon: '<i class="fas fa-sync-alt"></i>'
        }) }}
    </form>
</div>

{# ── Stats bar ─────────────────────────────────────────────────── #}
{% if companies is not empty %}
{% set total_contacts = 0 %}
{% set with_contacts = 0 %}
{% for company in companies %}
    {% set cnt = company.companyContacts|length %}
    {% set total_contacts = total_contacts + cnt %}
    {% if cnt > 0 %}{% set with_contacts = with_contacts + 1 %}{% endif %}
{% endfor %}
<div class="stats-bar">
    <div class="stat-card">
        <div class="stat-card__label">Entreprises</div>
        <div class="stat-card__value stat-card__value--accent">{{ companies|length }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">Avec contacts</div>
        <div class="stat-card__value stat-card__value--success">{{ with_contacts }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">Sans contacts</div>
        <div class="stat-card__value stat-card__value--warning">{{ companies|length - with_contacts }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">Total contacts</div>
        <div class="stat-card__value">{{ total_contacts }}</div>
    </div>
</div>

{# ── Search ────────────────────────────────────────────────────── #}
<div class="search-row">
    <div class="search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" id="searchTable" placeholder="Rechercher une entreprise, email, ville…">
    </div>
    <div class="result-pill">
        <span class="result-pill__count" id="resultCount">{{ companies|length }}</span>
        résultat{{ companies|length != 1 ? 's' : '' }}
    </div>
</div>
{% endif %}

{# ── Table / Empty state ───────────────────────────────────────── #}
{% if companies is empty %}
    <div class="empty-state">
        <i class="fas fa-building"></i>
        <p>Aucune entreprise synchronisée</p>
    </div>
{% else %}
    <div class="table-container">
        <div class="table-wrapper">
            <table class="companies-table">
                <thead>
                    <tr>
                        <th>Entreprise</th>
                        <th>Email</th>
                        <th>Ville</th>
                        <th>Site web</th>
                        <th>Contacts</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="companiesTableBody">
                    {% for company in companies %}
                        {# Main row #}
                        <tr data-id="{{ loop.index }}" onclick="toggleRow({{ loop.index }})">
                            <td>
                                <div class="co-cell">
                                    <div class="co-icon"><i class="fas fa-building"></i></div>
                                    <span class="co-name" title="{{ company.name }}">{{ company.name }}</span>
                                </div>
                            </td>
                            <td>
                                {% if company.email %}
                                    <div class="meta">
                                        <i class="fas fa-envelope"></i>
                                        <span title="{{ company.email }}">{{ company.email }}</span>
                                    </div>
                                {% else %}
                                    <span class="meta--empty">Non renseigné</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if company.city %}
                                    <div class="meta">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span>{{ company.city }}{% if company.country %}, {{ company.country }}{% endif %}</span>
                                    </div>
                                {% else %}
                                    <span class="meta--empty">Non renseignée</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if company.website %}
                                    <div class="meta">
                                        <i class="fas fa-globe"></i>
                                        <span title="{{ company.website }}">{{ company.website }}</span>
                                    </div>
                                {% else %}
                                    <span class="meta--empty">Non renseigné</span>
                                {% endif %}
                            </td>
                            <td>
                                {% set cnt = company.companyContacts|length %}
                                <span class="contacts-badge {% if cnt > 0 %}contacts-badge--has{% else %}contacts-badge--empty{% endif %}">
                                    <i class="fas {% if cnt > 0 %}fa-users{% else %}fa-user-slash{% endif %}"></i>
                                    {{ cnt }}
                                </span>
                            </td>
                            <td>
                                <i class="fas fa-chevron-down chev" id="chev-{{ loop.index }}"></i>
                            </td>
                        </tr>

                        {# Expanded contacts row #}
                        <tr class="expanded-row" id="exp-{{ loop.index }}">
                            <td colspan="6">
                                <div class="expanded-inner">
                                    <h3 class="expanded-title">
                                        <i class="fas fa-users"></i>
                                        Contacts associés
                                    </h3>
                                    {% if company.companyContacts is empty %}
                                        <p class="no-contacts">Aucun contact associé à cette entreprise.</p>
                                    {% else %}
                                        <div class="contacts-grid">
                                            {% for relation in company.companyContacts %}
                                                <div class="contact-card">
                                                    <div class="contact-avatar">
                                                        {{ relation.contact.firstname|first|upper }}{{ relation.contact.lastname|first|upper }}
                                                    </div>
                                                    <div class="contact-info">
                                                        <p class="contact-name">
                                                            {{ relation.contact.firstname }} {{ relation.contact.lastname }}
                                                        </p>
                                                        {% if relation.contact.email %}
                                                            <p class="contact-email" title="{{ relation.contact.email }}">
                                                                {{ relation.contact.email }}
                                                            </p>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // Toggle un seul panneau à la fois
        function toggleRow(id) {
            const expRow = document.getElementById('exp-' + id);
            const chev   = document.getElementById('chev-' + id);
            const isOpen = expRow.classList.contains('show');

            // Ferme tout
            document.querySelectorAll('.expanded-row').forEach(r => r.classList.remove('show'));
            document.querySelectorAll('.chev').forEach(c => c.classList.remove('open'));

            // Ouvre si c'était fermé
            if (!isOpen) {
                expRow.classList.add('show');
                chev.classList.add('open');
            }
        }

        // Recherche en direct
        document.getElementById('searchTable')?.addEventListener('input', function () {
            const term = this.value.toLowerCase();
            const rows = document.querySelectorAll('#companiesTableBody tr:not(.expanded-row)');
            let count = 0;

            rows.forEach(row => {
                const visible = row.textContent.toLowerCase().includes(term);
                row.style.display = visible ? '' : 'none';

                const id = row.dataset.id;
                const exp = document.getElementById('exp-' + id);
                if (exp && !visible) {
                    exp.classList.remove('show');
                    document.getElementById('chev-' + id)?.classList.remove('open');
                }
                if (visible) count++;
            });

            document.getElementById('resultCount').textContent = count;
        });
    </script>
{% endif %}

{% endblock %}
