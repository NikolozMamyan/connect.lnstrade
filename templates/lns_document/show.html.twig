{% extends 'layout/app.html.twig' %}

{% block title %}{{ document.displayTitle }} · Documents LNS{% endblock %}
{% block page_title %}{{ document.displayTitle }}{% endblock %}
{% block page_subtitle %}Aperçu en lecture seule du document LNS.{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@400;500;600&display=swap" rel="stylesheet">
{% endblock %}

{% block page_actions %}
    <a href="{{ path('lns_documents_index') }}" class="btn btn-secondary btn-md" data-turbo="false">
        <i class="fas fa-arrow-left"></i>
        Retour
    </a>
    <a href="{{ path('lns_documents_edit', {id: document.id}) }}" class="btn btn-secondary btn-md" data-turbo="false">
        <i class="fas fa-pen"></i>
        Modifier
    </a>
    {% if document.draft %}
        <span class="tag tag-warning">Brouillon — à valider avant export</span>
    {% else %}
        <a href="{{ path('lns_documents_pdf', {id: document.id}) }}" class="btn btn-primary btn-md" data-turbo="false">
            <i class="fas fa-file-pdf"></i>
            Générer le PDF
        </a>
    {% endif %}
{% endblock %}

{% block content %}
    {% include 'lns_document/_document.html.twig' %}
{% endblock %}
