<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#eef3f8;font-family:Arial,'Helvetica Neue',sans-serif;color:#152238;">
    {% set hasErrors = not completed or errors is not empty %}
    {% set accent = hasErrors ? '#dc5a4f' : '#16a085' %}
    {% set accentDark = hasErrors ? '#963c34' : '#0f766e' %}

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;background:#eef3f8;">
        <tr>
            <td align="center" style="padding:34px 14px;">
                <table role="presentation" width="720" cellspacing="0" cellpadding="0" style="width:100%;max-width:720px;border-collapse:separate;border-spacing:0;background:#ffffff;border-radius:28px;overflow:hidden;box-shadow:0 20px 55px rgba(21,34,56,.12);">
                    <tr>
                        <td style="padding:36px 38px;background:#102a43;background-image:linear-gradient(135deg,#102a43 0%,#174f6b 55%,{{ accentDark }} 100%);color:#ffffff;">
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td>
                                        <span style="display:inline-block;padding:8px 13px;border-radius:999px;background:rgba(255,255,255,.14);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;">Orders HubSpot</span>
                                    </td>
                                    <td align="right" style="font-size:12px;color:rgba(255,255,255,.78);">
                                        {{ dateTo|date('d/m/Y') }}
                                    </td>
                                </tr>
                            </table>

                            <h1 style="margin:22px 0 10px;font-size:30px;line-height:1.18;letter-spacing:-.02em;">
                                {% if not completed %}
                                    La synchronisation a ete interrompue
                                {% elseif errors is not empty %}
                                    Synchronisation terminee avec {{ errors|length }} erreur{{ errors|length > 1 ? 's' : '' }}
                                {% elseif warnings is not empty %}
                                    Orders a jour, {{ warnings|length }} point{{ warnings|length > 1 ? 's' : '' }} a verifier
                                {% else %}
                                    Les Orders sont a jour
                                {% endif %}
                            </h1>
                            <p style="margin:0;max-width:590px;font-size:15px;line-height:1.7;color:rgba(255,255,255,.88);">
                                Analyse Sage du <strong style="color:#ffffff;">{{ dateFrom|date('d/m/Y') }}</strong> au <strong style="color:#ffffff;">{{ dateTo|date('d/m/Y') }}</strong>.
                                {% if completed and errors is empty %}Aucune erreur bloquante n a ete detectee.{% endif %}
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:30px 34px 36px;">
                            {% if completed %}
                                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:separate;border-spacing:8px;margin:-8px;">
                                    <tr>
                                        {% set stats = [
                                            {label:'BL analyses', value:result.deliveryNotesAnalyzed|default(0), color:'#2563eb'},
                                            {label:'Factures', value:result.invoicesAnalyzed|default(0), color:'#7c3aed'},
                                            {label:'Orders crees', value:result.sent|default(0), color:'#0f9f76'},
                                            {label:'Actualises', value:result.updated|default(0), color:'#0891b2'}
                                        ] %}
                                        {% for stat in stats %}
                                            <td width="25%" style="padding:18px 12px;background:#f8fafc;border:1px solid #e7edf4;border-radius:16px;text-align:center;vertical-align:top;">
                                                <div style="font-size:25px;font-weight:800;color:{{ stat.color }};line-height:1;">{{ stat.value }}</div>
                                                <div style="margin-top:8px;font-size:10px;font-weight:700;color:#65758b;text-transform:uppercase;letter-spacing:.07em;line-height:1.35;">{{ stat.label }}</div>
                                            </td>
                                        {% endfor %}
                                    </tr>
                                </table>

                                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-top:18px;border-collapse:collapse;background:#f8fafc;border:1px solid #e7edf4;border-radius:16px;">
                                    <tr>
                                        <td style="padding:16px 18px;font-size:13px;color:#526276;">
                                            <strong style="color:#152238;">{{ result.skipped|default(0) }}</strong> document(s) deja a jour ignores
                                            &nbsp;&middot;&nbsp;
                                            <strong style="color:#152238;">{{ result.existing|default(0) }}</strong> Order(s) existants rattaches
                                            &nbsp;&middot;&nbsp;
                                            <strong style="color:#152238;">{{ result.changed|default(0) }}</strong> BL modifies a verifier
                                        </td>
                                    </tr>
                                </table>
                            {% endif %}

                            {% if fatalError %}
                                <div style="margin-top:22px;padding:20px 22px;background:#fff4f2;border:1px solid #f3c5c0;border-left:5px solid #dc5a4f;border-radius:16px;">
                                    <div style="font-size:11px;font-weight:800;color:#963c34;text-transform:uppercase;letter-spacing:.1em;">Erreur bloquante</div>
                                    <div style="margin-top:8px;font-size:14px;line-height:1.65;color:#7f302a;word-break:break-word;">{{ fatalError }}</div>
                                </div>
                            {% endif %}

                            {% if errors is not empty %}
                                <div style="margin-top:28px;">
                                    <div style="font-size:12px;font-weight:800;color:#963c34;text-transform:uppercase;letter-spacing:.1em;">Erreurs a corriger</div>
                                    <h2 style="margin:7px 0 16px;font-size:20px;color:#152238;">{{ errors|length }} document{{ errors|length > 1 ? 's' : '' }} non synchronise{{ errors|length > 1 ? 's' : '' }}</h2>

                                    {% for issue in errors %}
                                        {% include 'mailer/_delivery_order_issue.html.twig' with {issue: issue, tone: 'error'} only %}
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if warnings is not empty %}
                                <div style="margin-top:28px;">
                                    <div style="font-size:12px;font-weight:800;color:#a16207;text-transform:uppercase;letter-spacing:.1em;">Points de vigilance</div>
                                    <h2 style="margin:7px 0 16px;font-size:20px;color:#152238;">{{ warnings|length }} information{{ warnings|length > 1 ? 's' : '' }} a completer</h2>

                                    {% for issue in warnings %}
                                        {% include 'mailer/_delivery_order_issue.html.twig' with {issue: issue, tone: 'warning'} only %}
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if completed and errors is empty and warnings is empty %}
                                <div style="margin-top:24px;padding:22px;background:#effbf7;border:1px solid #bde8d8;border-radius:18px;text-align:center;">
                                    <div style="font-size:28px;line-height:1;">&#10003;</div>
                                    <div style="margin-top:10px;font-size:16px;font-weight:800;color:#0f766e;">Aucune action necessaire</div>
                                    <div style="margin-top:6px;font-size:13px;line-height:1.6;color:#537267;">Les donnees disponibles dans Sage ont bien ete appliquees aux Orders HubSpot.</div>
                                </div>
                            {% endif %}

                            <div style="margin-top:28px;text-align:center;">
                                <a href="{{ hubspotOrdersUrl }}" style="display:inline-block;padding:13px 22px;background:#102a43;color:#ffffff!important;text-decoration:none;border-radius:999px;font-size:13px;font-weight:800;box-shadow:0 9px 22px rgba(16,42,67,.18);">Consulter les Orders dans HubSpot</a>
                            </div>

                            <div style="margin-top:28px;padding-top:20px;border-top:1px solid #e7edf4;text-align:center;font-size:11px;line-height:1.6;color:#8190a3;">
                                Rapport automatique LNS Connecteur &middot; Ce message est envoye apres chaque synchronisation planifiee.
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
