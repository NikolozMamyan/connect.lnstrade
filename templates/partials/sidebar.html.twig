{% set current_route = app.request.attributes.get('_route') %}
{% set user_name = app.user ? app.user.fullName : 'Utilisateur' %}
{% set user_initials = user_name|slice(0, 1)|upper %}
{% set is_commercial_user = is_granted('ROLE_COM') and not is_granted('ROLE_ADMIN') %}
{% set operations_active = current_route starts with 'lns_documents_' or current_route starts with 'delivery_tracking_' %}
{% set synchronizations_active = current_route starts with 'flux_' %}
{% set analytics_active = current_route starts with 'supervision_statistics_' %}
{% set settings_active = current_route starts with 'supervision_settings_' or current_route starts with 'supervision_users_' or current_route starts with 'sync_logs' %}

<aside class="sidebar" data-sidebar>
    <div class="sidebar-logo">
        <div class="logo-mark">LS</div>
        <div class="logo-text">
            <span class="logo-name">lnstrade</span>
            <span class="logo-sub">Extranet</span>
        </div>
        <button class="sidebar-collapse-toggle" type="button" data-sidebar-collapse aria-label="Réduire la navigation" title="Réduire la navigation">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
    </div>

    <nav class="sidebar-nav" aria-label="Navigation principale">
        <a href="{{ path('app_dashboard') }}" class="nav-item {{ current_route == 'app_dashboard' ? 'active' : '' }}" title="Tableau de bord">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
            </svg>
            <span class="nav-label">Tableau de bord</span>
        </a>

        <div class="nav-group {{ operations_active ? 'is-open has-active' : 'is-open' }}" data-sidebar-group="operations" data-default-open="true" data-active="{{ operations_active ? 'true' : 'false' }}">
            <button class="nav-group-toggle" type="button" aria-expanded="true" aria-controls="sidebar-group-operations" title="Opérations">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18"/><path d="M5 7l1-3h12l1 3"/><path d="M5 7v13h14V7"/><path d="M9 11h6"/></svg>
                <span class="nav-group-label">Opérations</span>
                <svg class="nav-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <div class="nav-group-items" id="sidebar-group-operations">
                <div class="nav-group-items__inner">
                    <a href="{{ path('lns_documents_index') }}" class="nav-item nav-item--child {{ current_route starts with 'lns_documents_' ? 'active' : '' }}" data-turbo="false" title="Documents LNS">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
                        <span class="nav-label">Documents LNS</span>
                    </a>
                    <a href="{{ path('delivery_tracking_index') }}" class="nav-item nav-item--child {{ current_route starts with 'delivery_tracking_' ? 'active' : '' }}" title="Suivi livraison">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
                        <span class="nav-label">Suivi livraison</span>
                    </a>
                </div>
            </div>
        </div>

        {% if not is_commercial_user %}
            <div class="nav-group {{ synchronizations_active ? 'is-open has-active' : '' }}" data-sidebar-group="synchronizations" data-default-open="false" data-active="{{ synchronizations_active ? 'true' : 'false' }}">
                <button class="nav-group-toggle" type="button" aria-expanded="{{ synchronizations_active ? 'true' : 'false' }}" aria-controls="sidebar-group-synchronizations" title="Synchronisations">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10"/><path d="M20.49 15a9 9 0 0 1-14.85 3.36L1 14"/></svg>
                    <span class="nav-group-label">Synchronisations</span>
                    <svg class="nav-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
                <div class="nav-group-items" id="sidebar-group-synchronizations">
                    <div class="nav-group-items__inner">
                        <a href="{{ path('flux_client_index') }}" class="nav-item nav-item--child {{ current_route starts with 'flux_client' ? 'active' : '' }}" title="Clients">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span class="nav-label">Clients</span>
                        </a>
                        <a href="{{ path('flux_produits_index') }}" class="nav-item nav-item--child {{ current_route starts with 'flux_produits' ? 'active' : '' }}" title="Produits">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.73z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                            <span class="nav-label">Produits</span>
                        </a>
                        <a href="{{ path('flux_commandes_index') }}" class="nav-item nav-item--child {{ current_route starts with 'flux_commandes' ? 'active' : '' }}" title="Commandes / Deals">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                            <span class="nav-label">Commandes / Deals</span>
                        </a>
                        <a href="{{ path('flux_hubspot_orders_index') }}" class="nav-item nav-item--child {{ current_route starts with 'flux_hubspot_orders' ? 'active' : '' }}" title="Orders HubSpot">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
                            <span class="nav-label">Orders HubSpot</span>
                        </a>
                        <a href="{{ path('flux_factures_index') }}" class="nav-item nav-item--child {{ current_route starts with 'flux_factures' ? 'active' : '' }}" title="Factures">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
                            <span class="nav-label">Factures</span>
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="nav-group {{ analytics_active ? 'is-open has-active' : '' }}" data-sidebar-group="analytics" data-default-open="false" data-active="{{ analytics_active ? 'true' : 'false' }}">
            <button class="nav-group-toggle" type="button" aria-expanded="{{ analytics_active ? 'true' : 'false' }}" aria-controls="sidebar-group-analytics" title="Analyses">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                <span class="nav-group-label">Analyses</span>
                <svg class="nav-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <div class="nav-group-items" id="sidebar-group-analytics">
                <div class="nav-group-items__inner">
                    <a href="{{ path('supervision_statistics_index') }}" class="nav-item nav-item--child {{ current_route == 'supervision_statistics_index' ? 'active' : '' }}" title="Statistiques Sage">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        <span class="nav-label">Statistiques Sage</span>
                    </a>
                    <a href="{{ path('supervision_statistics_orderform') }}" class="nav-item nav-item--child {{ current_route == 'supervision_statistics_orderform' ? 'active' : '' }}" title="Statistiques Orderform">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                        <span class="nav-label">Statistiques Orderform</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="nav-group {{ settings_active ? 'is-open has-active' : '' }}" data-sidebar-group="settings" data-default-open="false" data-active="{{ settings_active ? 'true' : 'false' }}">
            <button class="nav-group-toggle" type="button" aria-expanded="{{ settings_active ? 'true' : 'false' }}" aria-controls="sidebar-group-settings" title="Paramètres">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21H9.6v-.1A1.7 1.7 0 0 0 8.5 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3V9.6h.1A1.7 1.7 0 0 0 4.6 8.5a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.1A1.7 1.7 0 0 0 15.5 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.13.38.34.72.6 1 .3.25.69.4 1.1.4h.1v4h-.1a1.7 1.7 0 0 0-1.7.6z"/></svg>
                <span class="nav-group-label">Paramètres</span>
                {% if not is_commercial_user and nb_erreurs is defined and nb_erreurs > 0 %}<span class="nav-badge">{{ nb_erreurs }}</span>{% endif %}
                <svg class="nav-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <div class="nav-group-items" id="sidebar-group-settings">
                <div class="nav-group-items__inner">
                    <a href="{{ path('supervision_settings_index') }}" class="nav-item nav-item--child {{ current_route starts with 'supervision_settings' ? 'active' : '' }}" title="Configuration">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
                        <span class="nav-label">Configuration</span>
                    </a>
                    {% if not is_commercial_user %}
                        <a href="{{ path('supervision_users_index') }}" class="nav-item nav-item--child {{ current_route starts with 'supervision_users' ? 'active' : '' }}" title="Utilisateurs">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span class="nav-label">Utilisateurs</span>
                        </a>
                        <a href="{{ path('sync_logs_index') }}" class="nav-item nav-item--child {{ current_route starts with 'sync_logs' ? 'active' : '' }}" title="Logs de synchronisation">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                            <span class="nav-label">Logs de synchronisation</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    <div class="sidebar-footer">
        <div class="user-card">
            <div class="user-avatar">{{ user_initials }}</div>
            <div class="user-info">
                <div class="user-name">{{ user_name }}</div>
                <div class="user-role">{{ app.user ? app.user.roles|first|replace({'ROLE_': '', '_': ' '})|title : '' }}</div>
            </div>
        </div>
    </div>
</aside>
