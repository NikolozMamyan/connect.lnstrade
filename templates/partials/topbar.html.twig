{% set user_name = app.user ? app.user.fullName : 'Utilisateur' %}
{% set user_initials = user_name|slice(0, 1)|upper %}
{% set unread_notifications = topbar_context.unreadNotificationCount %}
{% set latest_notifications = topbar_context.latestNotifications %}
{% set is_commercial_user = is_granted('ROLE_COM') and not is_granted('ROLE_ADMIN') %}

<header class="topbar" data-search-url="{{ path('app_global_search') }}">
    {% include 'partials/breadcrumb.html.twig' %}

    <div class="topbar-spacer"></div>

    {% if not is_commercial_user %}
        <div class="topbar-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8B90AB" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="topbar-search-input" placeholder="Rechercher..." autocomplete="off"/>
            <kbd class="search-kbd">Ctrl K</kbd>

            <div class="topbar-search-panel" id="topbar-search-panel" hidden>
                <div class="topbar-search-state" data-search-state="idle">Tapez au moins 2 caracteres pour lancer une recherche.</div>
                <div class="topbar-search-results" data-search-results></div>
            </div>
        </div>
    {% endif %}

    <div class="topbar-actions">
        {% if not is_commercial_user %}
            <div class="topbar-notification-wrap">
                <button class="icon-btn" title="Notifications" id="btn-notifications" aria-label="Voir les notifications" aria-expanded="false" aria-controls="topbar-notifications-panel" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    {% if unread_notifications > 0 %}
                        <span class="notif-dot"></span>
                    {% endif %}
                </button>

                <div class="topbar-popover" id="topbar-notifications-panel" hidden>
                    <div class="topbar-popover__header">
                        <div>
                            <strong>Notifications</strong>
                            <div class="topbar-popover__meta">{{ unread_notifications }} non lue(s)</div>
                        </div>
                        <form method="post" action="{{ path('app_notifications_read_all') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('notifications_read_all') }}">
                            <button type="submit" class="topbar-link-btn">Tout lire</button>
                        </form>
                    </div>
                    <div class="topbar-popover__body">
                        {% for notification in latest_notifications %}
                            <a href="{{ path('app_notifications_open', {id: notification.id}) }}" class="notification-item notification-item--{{ notification.level }} {{ not notification.isRead ? 'is-unread' : '' }}">
                                <span class="notification-item__pill"></span>
                                <span class="notification-item__content">
                                    <span class="notification-item__title">{{ notification.title }}</span>
                                    {% if notification.message %}
                                        <span class="notification-item__message">{{ notification.message }}</span>
                                    {% endif %}
                                    <span class="notification-item__date">{{ notification.createdAt ? notification.createdAt|date('d/m/Y H:i') : '' }}</span>
                                </span>
                            </a>
                        {% else %}
                            <div class="topbar-empty-state">Aucune notification pour le moment.</div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}

        <a href="{{ path('supervision_settings_index') }}" class="icon-btn" title="Aide" aria-label="Aide">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </a>

        {% if app.user %}
            <form method="post" action="{{ path('app_logout') }}">
                <button class="icon-btn" title="Se deconnecter" aria-label="Se deconnecter" type="submit">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </button>
            </form>

            <span class="topbar-avatar" title="{{ user_name }}" aria-label="Utilisateur connecte">
                {{ user_initials }}
            </span>
        {% endif %}
    </div>
</header>
